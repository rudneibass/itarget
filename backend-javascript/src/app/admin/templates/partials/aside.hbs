    <script>
    $(document).ready(function () {
        jQuery(document).ready(function () {
            const orgHeader = {
                defaultName: 'Organização',
                setOrganization: ({ nome, logoUrl }) => {
                    const name = (nome || orgHeader.defaultName).trim();
                    const initials = orgHeader.getInitials(name);
                    const $avatar = jQuery('#org-brand-avatar');
                    const $img = jQuery('#org-brand-logo');
                    const $initials = jQuery('#org-brand-initials');
                    const $name = jQuery('#org-brand-name');

                    $name.text(name);
                    $initials.text(initials);

                    if (logoUrl) {
                        $avatar.addClass('has-logo');
                        $img
                            .attr('src', logoUrl)
                            .off('error')
                            .on('error', function () {
                                $avatar.removeClass('has-logo');
                                $img.removeAttr('src');
                            });
                        return;
                    }

                    $avatar.removeClass('has-logo');
                    $img.removeAttr('src');
                },
                getInitials: (name) => {
                    const parts = (name || '')
                        .trim()
                        .split(/\s+/)
                        .filter(Boolean);

                    if (!parts.length) {
                        return 'OR';
                    }

                    if (parts.length === 1) {
                        return parts[0].slice(0, 2).toUpperCase();
                    }

                    return `${parts[0][0]}${parts[1][0]}`.toUpperCase();
                },
                extractOrganization: (source) => {
                    if (!source || typeof source !== 'object') {
                        return null;
                    }

                    const direct = source.organizacao || source.organization || source.org;
                    const candidate = direct || source;
                    const nome = candidate.nome || candidate.name || candidate.razaoSocial;
                    const logoUrl = candidate.logoUrl || candidate.logo || candidate.imagem || candidate.avatarUrl || candidate.foto;

                    if (!nome && !logoUrl) {
                        return null;
                    }

                    return { nome: nome || orgHeader.defaultName, logoUrl: logoUrl || null };
                },
                parseJSON: (value) => {
                    if (!value) {
                        return null;
                    }
                    try {
                        return JSON.parse(value);
                    } catch (error) {
                        return null;
                    }
                },
                findOrganizationInStorage: () => {
                    const storageKeys = ['session', 'socialSession', 'dadosSessao', 'user', 'usuario', 'auth'];

                    for (let i = 0; i < storageKeys.length; i += 1) {
                        const raw = window.localStorage.getItem(storageKeys[i]);
                        const parsed = orgHeader.parseJSON(raw);
                        const found = orgHeader.extractOrganization(parsed);
                        if (found) {
                            return found;
                        }
                    }

                    return null;
                },
                fetchOrganization: () => {
                    return new Promise((resolve) => {
                        jQuery.ajax({
                            url: `${admin.baseUrl}/organizacao/all`,
                            type: 'GET',
                            dataType: 'json',
                            success: (response) => {
                                const list = response?.data || [];
                                const active = list.find((item) => item?.ativo === true) || list[0];
                                resolve(orgHeader.extractOrganization(active));
                            },
                            error: () => resolve(null),
                        });
                    });
                },
                init: async () => {
                    const fromStorage = orgHeader.findOrganizationInStorage();
                    if (fromStorage) {
                        orgHeader.setOrganization(fromStorage);
                        return;
                    }

                    const fromApi = await orgHeader.fetchOrganization();
                    orgHeader.setOrganization(fromApi || { nome: orgHeader.defaultName, logoUrl: null });
                },
            };

            jQuery("#jquery-accordion-menu").jqueryAccordionMenu();
            jQuery('.submenu li a').on('click', function() {
                const $aside = $('.submenu').css("display", "none");
            });
            jQuery(".colors a").click(function () {
                if ($(this).attr("class") != "default") {
                    $("#jquery-accordion-menu").removeClass();
                    $("#jquery-accordion-menu").addClass("jquery-accordion-menu").addClass($(this).attr("class"));
                } else {
                    $("#jquery-accordion-menu").removeClass();
                    $("#jquery-accordion-menu").addClass("jquery-accordion-menu");
                }
            });

            orgHeader.init();
            
        });
    });
