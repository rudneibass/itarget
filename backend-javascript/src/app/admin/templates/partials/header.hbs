<header>
    <div class="header">
        <div class="d-flex align-items-center">
            <a class="text-muted cursor-pointer" id="aside-control">
                <i class="fa fa-bars"></i>
            </a>
        </div>

        <div class="d-flex align-items-center header-actions">
          <a class="header-modules-link" href="/landing/modulos" title="Voltar para seleção de módulos">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Módulos</span>
          </a>
        </div>
    </div>
    <style>
        header{
            width: 100%;
        }
        .header{
            border: 1px solid var(--border-color-default);
            border-radius: var(--border-radius-default);
            background-color: var(--color-default-light);
            box-shadow: var(--shadows-default);
            padding: 10px 15px; 
            margin-bottom: 10px;

            display: flex;
            justify-content: space-between;
            align-items: center;

            width: 100%;
        }
    .header-actions{
      gap: 12px;
    }
    .header-modules-link{
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 36px;
      padding: 0 12px;
      border-radius: 10px;
      border: 1px solid var(--border-color-default);
      background: #ffffff;
      color: var(--color-primary, #1f4fa3);
      text-decoration: none;
      font-size: 13px;
      font-weight: 700;
      box-shadow: var(--shadows-default);
    }
    .header-modules-link:hover{
      text-decoration: none;
      color: var(--color-primary, #1f4fa3);
      filter: brightness(0.98);
    }
    </style>
    <script>
        $(document).ready(function() {
          $('#aside-control').on('click', function() {
            const $aside = $('aside');
            if ($aside.hasClass('width-320-px') || !$aside.hasClass('width-65-px')) {
              $aside.removeClass('width-320-px');
              $aside.addClass('width-65-px')
            } else {
              $aside.addClass('width-320-px');
              $aside.removeClass('width-65-px');
            }
          });
        })
    </script>
</header>

