<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acesso Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
    <style>
      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f4f6fb;
        padding: 16px;
      }
      .auth-card {
        width: 100%;
        max-width: 520px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, .08);
        padding: 22px;
      }
    </style>
  </head>
  <body>
    <section class="auth-card">
      <h4 class="mb-3">Admin Multiusuário</h4>
      <p class="text-muted mb-3">Cadastre-se para criar sua organização e acessar o admin.</p>

      <ul class="nav nav-tabs" id="auth-tabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active text-muted" id="login-tab" data-bs-toggle="tab" data-bs-target="#login-pane" type="button" role="tab">Entrar</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="register-tab" data-bs-toggle="tab" data-bs-target="#register-pane" type="button" role="tab">Cadastrar</button>
        </li>
      </ul>

      <div class="tab-content pt-3">
        <div class="tab-pane fade show active" id="login-pane" role="tabpanel">
          <form id="form-login">
            <div class="mb-3">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" id="login-email" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Senha</label>
              <input type="password" class="form-control" id="login-senha" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
          </form>
        </div>

        <div class="tab-pane fade" id="register-pane" role="tabpanel">
          <form id="form-register">
            <div class="mb-3">
              <label class="form-label">Nome</label>
              <input type="text" class="form-control" id="register-nome" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" id="register-email" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Senha</label>
              <input type="password" class="form-control" id="register-senha" required />
            </div>
            <button type="submit" class="btn btn-success w-100">Cadastrar e entrar</button>
          </form>
        </div>
      </div>

      <div id="auth-message" class="mt-3 text-danger"></div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      (() => {
        const showError = (message) => {
          $('#auth-message').text(message || 'Não foi possível concluir a operação.');
        };

        const redirectToAdmin = () => {
          window.location.href = '/admin/home';
        };

        $('#form-login').on('submit', async (event) => {
          event.preventDefault();
          $('#auth-message').empty();

          try {
            await $.ajax({
              url: '/admin/auth/login',
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({
                email: $('#login-email').val(),
                senha: $('#login-senha').val(),
              }),
            });
            redirectToAdmin();
          } catch (error) {
            showError(error?.responseJSON?.message || error?.responseText || 'Credenciais inválidas.');
          }
        });

        $('#form-register').on('submit', async (event) => {
          event.preventDefault();
          $('#auth-message').empty();

          try {
            await $.ajax({
              url: '/admin/auth/register',
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({
                nome: $('#register-nome').val(),
                email: $('#register-email').val(),
                senha: $('#register-senha').val(),
              }),
            });
            redirectToAdmin();
          } catch (error) {
            showError(error?.responseJSON?.message || error?.responseText || 'Não foi possível cadastrar.');
          }
        });
      })();
    </script>
  </body>
</html>
