<section>
    <style>
        .perfil-form-tab-content {
            min-height: calc(100vh - 160px);
            display: flex;
            flex-direction: column;
            padding: .75rem;
            box-shadow: var(--shadows-default);
        }

        .perfil-form-tab-pane {
            display: flex;
            flex-direction: column;
            flex: 1;
            position: relative;
        }

        .perfil-form-main {
            flex: 1;
        }

        .perfil-form-actions {
            position: absolute;
            width: 100%;
            bottom: 0;
            top: auto;
            right: auto;
            z-index: 10;
            display: flex;
            flex-direction: row;
            justify-content: end;
            gap: .5rem;
            margin-top: auto;
            padding-top: .75rem;
            border-top: 1px solid var(--border-color-default);
            background-color: #fff;
        }

        .perfil-form-actions .section-actions-btn-parent {
            width: auto;
        }

        .perfil-form-actions .btn {
            width: 150px;
            height: auto;
            border-radius: .375rem;
            padding: .375rem .75rem;
            gap: .45rem;
            border-radius: 3px !important;
        }

        @media (max-width: 767px) {
            .perfil-form-tab-content {
                min-height: calc(100vh - 130px);
            }

            .perfil-form-actions {
                flex-wrap: wrap;
                justify-content: start;
            }
        }
    </style>
    <div class="col-md-12 p-0">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active text-muted" data-bs-toggle="tab" href="#tab-meu-perfil">Meu Perfil</a>
            </li>
        </ul>
        <div class="tab-content bg-white border border-top-0 perfil-form-tab-content">
            <div class="tab-pane active perfil-form-tab-pane" id="tab-meu-perfil">
                <form id="form-meu-perfil" class="perfil-form-main">
                    <input type="hidden" id="id" name="id" />
                    <input type="hidden" id="uuid" name="uuid" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Nome</small>
                                </label>
                                <input type="text" name="nome" class="form-control" id="nome" maxlength="255" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Email</small>
                                </label>
                                <input type="email" name="email" class="form-control" id="email" maxlength="255" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Senha</small>
                                </label>
                                <input type="password" name="senha" class="form-control" id="senha" minlength="6" placeholder="Preencha apenas se quiser alterar" />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-text text-muted">
                                A senha sera atualizada somente se um novo valor for informado.
                            </div>
                        </div>
                        <div class="col-md-4 mt-2">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Avatar do usuário</small>
                                </label>
                                <div class="mb-2">
                                    <img
                                        id="usuario-avatar-preview"
                                        src=""
                                        alt="Avatar do usuário"
                                        style="width: 96px; height: 96px; object-fit: cover; border-radius: 50%; border: 1px solid #ddd; display: none;"
                                    />
                                </div>
                                <input type="file" name="avatarFile" class="form-control" id="avatarFile" accept="image/*" />
                            </div>
                        </div>
                    </div>
                </form>

                <section class="section-actions perfil-form-actions">
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-perfil-editar" class="btn btn-secondary btn-float">
                            <i class="fa fa-lock"></i>
                            <span class="btn-label">Editar</span>
                        </button>
                    </div>
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-perfil-salvar" class="btn btn-success btn-float">
                            <i class="fa fa-floppy-o"></i>
                            <span class="btn-label">Salvar</span>
                        </button>
                    </div>
                </section>
            </div>
        </div>
    </div>
    <br/>
</section>

<script>
    (() => {
        const meuPerfilForm = {
            formId: 'form-meu-perfil',
            profileUuid: '{{uuid}}',
            setAvatarPreview: (url) => {
                const $preview = $('#usuario-avatar-preview');
                if (!url) {
                    $preview.hide().attr('src', '');
                    return;
                }
                $preview.attr('src', `${url}?t=${Date.now()}`).show();
            },
            loadAvatar: (usuarioId) => {
                if (!usuarioId) {
                    meuPerfilForm.setAvatarPreview(null);
                    return;
                }

                $.ajax({
                    url: `${admin.baseUrl}/arquivo/avatar`,
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        entidadePai: 'usuario-admin',
                        entidadePaiId: usuarioId,
                    },
                    success: function (response) {
                        const avatarUrl = response?.data?.url || null;
                        meuPerfilForm.setAvatarPreview(avatarUrl);
                    },
                    error: function () {
                        meuPerfilForm.setAvatarPreview(null);
                    },
                });
            },
            uploadAvatar: ({ usuarioId, onSuccess, onError }) => {
                const input = document.getElementById('avatarFile');
                const file = input?.files?.[0];

                if (!file || !usuarioId) {
                    if (typeof onSuccess === 'function') {
                        onSuccess(false);
                    }
                    return;
                }

                const formData = new FormData();
                formData.append('file', file);

                $.ajax({
                    url: `${admin.baseUrl}/arquivo/upload-local-server?entidadePai=usuario-admin&entidadePaiId=${usuarioId}&slug=avatar`,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function () {
                        $('#avatarFile').val('');
                        meuPerfilForm.loadAvatar(usuarioId);
                        if (typeof onSuccess === 'function') {
                            onSuccess(true);
                        }
                    },
                    error: function (jqXHR) {
                        if (typeof onError === 'function') {
                            onError(jqXHR);
                        }
                    },
                });
            },
            edit: () => {
                $(`#${meuPerfilForm.formId} :input`).prop('disabled', false);
            },
            disable: () => {
                $(`#${meuPerfilForm.formId} :input`).prop('disabled', true);
            },
            load: () => {
                if (!meuPerfilForm.profileUuid) {
                    toastr['error']('Nao foi possivel identificar o usuario logado.');
                    meuPerfilForm.disable();
                    return;
                }

                $.ajax({
                    url: `${admin.baseUrl}/usuario/${meuPerfilForm.profileUuid}`,
                    type: 'GET',
                    dataType: 'json',
                    beforeSend: function () {
                        admin.loading(true);
                        meuPerfilForm.disable();
                    },
                    error: function () {
                        admin.loading(false);
                        toastr['error']('Nao foi possivel carregar o perfil do usuario logado.');
                    },
                    success: function (response) {
                        admin.loading(false);
                        const data = response?.data || {};
                        const $form = $('#' + meuPerfilForm.formId);
                        $form.find('[name="id"]').val(data.id || '');
                        $form.find('[name="uuid"]').val(data.uuid || '');
                        $form.find('[name="nome"]').val(data.nome || '');
                        $form.find('[name="email"]').val(data.email || '');
                        $form.find('[name="senha"]').val('');
                        meuPerfilForm.loadAvatar(data.id);
                    }
                });
            },
            save: () => {
                if ($(`#${meuPerfilForm.formId} :input`).first().is(':disabled')) {
                    return;
                }

                if (!meuPerfilForm.profileUuid) {
                    toastr['error']('Nao foi possivel identificar o usuario logado.');
                    return;
                }

                const $form = $('#' + meuPerfilForm.formId);
                const payload = {
                    nome: $form.find('[name="nome"]').val(),
                    email: $form.find('[name="email"]').val(),
                };

                const senha = $form.find('[name="senha"]').val();
                if (senha) {
                    payload.senha = senha;
                }

                if (!payload.nome || !payload.email) {
                    toastr['error']('Nome e email sao obrigatorios.');
                    return;
                }

                $.ajax({
                    url: `${admin.baseUrl}/usuario/${meuPerfilForm.profileUuid}`,
                    type: 'PATCH',
                    dataType: 'json',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    beforeSend: function () {
                        admin.loading(true);
                    },
                    error: function (jqXHR) {
                        admin.loading(false);
                        const message = jqXHR?.responseJSON?.message || jqXHR?.responseText || 'Nao foi possivel atualizar o perfil.';
                        toastr['error'](Array.isArray(message) ? message.join(', ') : message);
                    },
                    success: function (responseData) {
                        admin.loading(false);
                        const data = responseData?.data || {};
                        if (data?.id) {
                            $form.find('[name="id"]').val(data.id);
                        }
                        if (data?.uuid) {
                            $form.find('[name="uuid"]').val(data.uuid);
                        }
                        $form.find('[name="senha"]').val('');

                        const persistedId = Number($form.find('[name="id"]').val() || data?.id || 0);
                        meuPerfilForm.uploadAvatar({
                            usuarioId: persistedId,
                            onSuccess: (uploaded) => {
                                if (uploaded) {
                                    toastr['success']('Perfil e avatar atualizados com sucesso.');
                                } else {
                                    toastr['success']('Perfil atualizado com sucesso.');
                                }
                                meuPerfilForm.disable();
                                meuPerfilForm.load();
                            },
                            onError: (jqXHR) => {
                                const message = jqXHR?.responseJSON?.message || jqXHR?.responseText || 'Perfil salvo, mas o upload do avatar falhou.';
                                toastr['warning'](message);
                                meuPerfilForm.disable();
                                meuPerfilForm.load();
                            },
                        });
                    }
                });
            }
        };

        window.meuPerfilForm = meuPerfilForm;

        document.getElementById('btn-perfil-editar')?.addEventListener('click', () => {
            meuPerfilForm.edit();
        });

        document.getElementById('btn-perfil-salvar')?.addEventListener('click', () => {
            meuPerfilForm.save();
        });

        meuPerfilForm.load();
    })();
</script>
