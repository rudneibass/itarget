<section class="section-actions">
    <div class="section-actions-btn-parent">
        <button
            class="btn btn-success btn-float section-actions-btn"
            onclick="admin.addTab({tabId:'form-usuario-admin', title: 'Novo Usuário Admin', url: '/admin/usuario/form'})"
        >
            <i class="fa fa-plus"></i>
            <span class="btn-label">Novo</span>
        </button>
    </div>
</section>

<section>
    <div class="page-info-bar shadows-default">
        <small><i class="fa fa-users"></i></small>
        <small>Colaboradores</small>
    </div>
</section>

<section>
    <div class="list-table-container">
        <table class="table table-sm table-striped table-hover width-100">
            <tbody id="tbody-usuario-admin"></tbody>
        </table>
        <div class="text-center">
            <span class="pt-5" id="messages-usuario-admin"></span>
        </div>
    </div>
</section>

<script>
    (() => {
    const usuarioAdminList = {
        list: () => {
            $.ajax({
                url: `${admin.baseUrl}/usuario/all`,
                cache: false,
                type: 'GET',
                dataType: 'json',
                beforeSend: function () {
                    $('#messages-usuario-admin').empty();
                    $('#tbody-usuario-admin').empty();
                    admin.loading(true);
                },
                error: function () {
                    admin.loading(false);
                    $('#messages-usuario-admin').html("<h6 class='text-muted text-center'>Não foi possível carregar os usuários admin.</h6>");
                },
                success: function (response) {
                    admin.loading(false);
                    const data = response?.data || [];

                    if (!data.length) {
                        $('#messages-usuario-admin').html("<h6 class='text-muted text-center'>Nenhum registro encontrado.</h6>");
                        return;
                    }

                    data.forEach((item) => {
                        $('#tbody-usuario-admin').append(`
                            <tr>
                                <td class="p-3" style="width:90%; vertical-align: middle;">
                                    <small><b>Nome: </b>${item.nome || ''}</small><br/>
                                    <small><b>Email: </b>${item.email || ''}</small><br/>
                                    <small><b>Status: </b></small>${item.ativo ? '<small class="badge bg-success">Ativo</small>' : '<small class="badge bg-secondary">Inativo</small>'}</small>
                                </td>
                                <td style="width: 150px; vertical-align: middle;">
                                    <button
                                        class="btn btn-sm btn-secondary btn-sm w-100 mb-2"
                                        onclick="admin.addTab({tabId:'form-usuario-admin', title: 'Editar Usuário Admin', url: '/admin/usuario/form/uuid/${item.uuid}'})"
                                    >
                                        <i class="fa fa-pencil"></i> Editar
                                    </button>
                                    <button class="btn btn-sm btn-danger btn-sm w-100" onclick="usuarioAdminList.remove('${item.uuid}')">
                                        <i class="fa fa-trash-o"></i> Excluir
                                    </button>
                                </td>
                            </tr>
                        `);
                    });
                },
            });
        },
        remove: (uuid) => {
            bootbox.confirm({
                title: 'Atenção',
                message: 'Tem certeza que deseja remover este usuário admin?',
                buttons: {
                    confirm: {
                        label: '<i class="fa fa-check"></i> Confirmar',
                        className: 'btn-sm btn-success',
                    },
                    cancel: {
                        label: '<i class="fa fa-undo"></i> Cancelar',
                        className: 'btn-sm btn-secondary',
                    },
                },
                callback: function (result) {
                    if (!result) {
                        return;
                    }

                    $.ajax({
                        url: `${admin.baseUrl}/usuario/${uuid}`,
                        type: 'DELETE',
                        beforeSend: function () {
                            admin.loading(true);
                        },
                        success: function () {
                            admin.loading(false);
                            toastr['success']('Usuário admin removido com sucesso.');
                            usuarioAdminList.list();
                        },
                        error: function () {
                            admin.loading(false);
                            toastr['error']('Não foi possível remover o usuário admin.');
                        },
                    });
                },
            });
        },
    };

    window.usuarioAdminList = usuarioAdminList;
    usuarioAdminList.list();
    })();
</script>
