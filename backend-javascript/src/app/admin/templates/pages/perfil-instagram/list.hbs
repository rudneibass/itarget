<section class="section-actions">
    <div class="section-actions-btn-parent">
        <button
            class="btn btn-success btn-float section-actions-btn"
            onclick="admin.addTab({tabId:'form-perfil-instagram', title: 'Novo Perfil Instagram', url: '/admin/perfil-instagram/form'})"
        >
            <i class="fa fa-plus"></i>
            <span class="btn-label">Novo</span>
        </button>
    </div>
    <div class="section-actions-btn-parent">
        <button class="btn btn-warning btn-float section-actions-btn" id="btn-toggle-barra-perfil-instagram">
            <i class="fa fa-search"></i>
            <span class="btn-label">Pesquisar</span>
        </button>
    </div>
</section>

<section class="section-search-bar hide" id="section-search-bar-perfil-instagram">
    <div class="row search-bar" id="search-bar-perfil-instagram">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-success-light"><span class="text-muted">Pesquisa por...</span></div>
                <div class="card-body">
                    <form id="formSearchPerfilInstagram">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="input-group mb-3">
                                    <input type="text" name="uuid" id="uuid" class="form-control" placeholder="Código">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="input-group mb-3">
                                    <input type="text" name="perfil" id="perfil" class="form-control" placeholder="Perfil">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="input-group mb-3">
                                    <input type="text" name="categoria" id="categoria" class="form-control" placeholder="Categoria">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="input-group mb-3">
                                    <select name="ativo" id="ativo" class="form-select">
                                        <option value="">Status</option>
                                        <option value="true">Ativo</option>
                                        <option value="false">Inativo</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer p-2 border-top-0">
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-pesquisar-perfil-instagram">
                        <i class="fa fa-search"></i> Pesquisar
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="page-info-bar shadows-default">
        <small><i class="fa fa-instagram"></i></small>
        <small>Perfis Instagram</small>
    </div>
</section>

<section>
    <div class="list-table-container">
        <table class="table table-sm table-striped table-hover width-100">
            <thead id="thead-perfil-instagram"></thead>
            <tbody id="tbody-perfil-instagram"></tbody>
        </table>
        <div class="text-center">
            <span class="pt-5" id="messages-perfil-instagram"></span>
        </div>
    </div>
    <div class="pagination-bar-default">
        <div>
            <small class="gray-default" id="total-perfil-instagram"></small>
        </div>
        <div>
            <i class="fa fa-chevron-left gray-default cursor-pointer" id="anterior-perfil-instagram"></i>
            &emsp;
            <span class="gray-default" id="numeracao-perfil-instagram"></span>
            &emsp;
            <i class="fa fa-chevron-right gray-default cursor-pointer" id="proximo-perfil-instagram"></i>
        </div>
    </div>
</section>

<script>
    (() => {
    const perfilInstagramList = {
        formSearchId: 'formSearchPerfilInstagram',
        list: ({ url, formSearchId }) => {
            $.ajax({
                url,
                cache: false,
                type: 'GET',
                data: $('#' + formSearchId).serialize(),
                dataType: 'json',
                beforeSend: function () {
                    $('#messages-perfil-instagram').empty();
                    $('#tbody-perfil-instagram').empty();
                    admin.loading(true);
                },
                error: function () {
                    admin.loading(false);
                    $('#tbody-perfil-instagram').empty();
                    $('#messages-perfil-instagram').empty();
                    $('#messages-perfil-instagram').html("<h6 class='text-muted text-center'>Não foi possivel executar a ação desejada, favor entrar em contato com o administrador.</h6>");
                },
                success: function (response) {
                    var source = response?.data || response || [];
                    var filters = $('#' + formSearchId).serializeArray().reduce((obj, item) => {
                        obj[item.name] = item.value;
                        return obj;
                    }, {});

                    var data = source.filter((item) => {
                        const byUuid = !filters.uuid || String(item.uuid || '').toLowerCase().includes(String(filters.uuid).toLowerCase());
                        const byPerfil = !filters.perfil || String(item.perfil || '').toLowerCase().includes(String(filters.perfil).toLowerCase());
                        const byCategoria = !filters.categoria || String(item.categoria || '').toLowerCase().includes(String(filters.categoria).toLowerCase());
                        const byAtivo = !filters.ativo || String(!!item.ativo) === String(filters.ativo);
                        return byUuid && byPerfil && byCategoria && byAtivo;
                    });

                    if (!data[0]) {
                        admin.loading(false);
                        $('#tbody-perfil-instagram').empty();
                        $('#messages-perfil-instagram').empty();
                        $('#messages-perfil-instagram').html("<br/><br/><h6 class='text-muted text-center'>Consulta não obteve resultados.</h6>");
                        return;
                    }

                    admin.loading(false);
                    $('#tbody-perfil-instagram').empty();
                    $('#messages-perfil-instagram').empty();

                    var tamanhoPagina = 10;
                    var pagina = 0;

                    function paginar() {
                        for (var i = pagina * tamanhoPagina; i < data.length && i < (pagina + 1) * tamanhoPagina; i++) {
                            $('#tbody-perfil-instagram').append(
                                `<tr>
                                    <td class="p-3" style="width:90%; vertical-align: middle;">
                                        <div>
                                            <small>
                                                <b>Perfil:</b> @${data[i].perfil || ''}
                                                ${data[i].ativo
                                                    ? '&emsp;<span class="badge bg-success">Ativo</span>'
                                                    : '&emsp;<span class="badge bg-secondary">Inativo</span>'
                                                }
                                            </small>
                                            <br/>
                                            <small><b>Categoria:</b> ${data[i].categoria || '-'}</small>
                                            <br/>
                                            <small><b>Sincronizado em:</b> ${data[i].sincronizadoEm ? new Date(data[i].sincronizadoEm).toLocaleString('pt-BR') : 'Nunca sincronizado'}</small>
                                            <br/>
                                            <small><b>Código:</b> ${data[i].uuid || ''}</small>
                                        </div>
                                    </td>
                                    <td style="width: 8%; vertical-align: middle;">
                                        <center>
                                            <button
                                                class="btn btn-secondary btn-sm w-100 mb-2"
                                                onclick="admin.addTab({tabId:'form-perfil-instagram', title: 'Editar Perfil Instagram', url: '/admin/perfil-instagram/form/uuid/${data[i].uuid}'})"
                                            >
                                                <i class="fa fa-pencil"></i> Editar
                                            </button>
                                            ${data[i].ativo
                                                ? `<button class="btn btn-secondary btn-sm w-100 mb-2" onclick="perfilInstagramList.toggleAtivo('${data[i].uuid}', false)">
                                                    <i class="fa fa-download"></i> Desativar
                                                </button>`
                                                : `<button class="btn btn-secondary btn-sm w-100 mb-2" onclick="perfilInstagramList.toggleAtivo('${data[i].uuid}', true)">
                                                    <i class="fa fa-upload"></i> Ativar
                                                </button>`
                                            }
                                            <button class="btn btn-secondary btn-sm w-100 mb-2" onclick="perfilInstagramList.remove('${data[i].uuid}')">
                                                <i class="fa fa-trash-o"></i>
                                                <span> Excluir</span>
                                            </button>
                                            <button class="btn btn-info btn-sm w-100 mb-2" onclick="perfilInstagramList.syncInstagram('${data[i].uuid}')">
                                                <i class="fa fa-refresh"></i>
                                                <span> Sincronizar</span>
                                            </button>
                                        </center>
                                    </td>
                                </tr>`
                            );
                        }
                        $('#numeracao-perfil-instagram').text('Página ' + (pagina + 1) + ' de ' + Math.ceil(data.length / tamanhoPagina));
                        $('#total-perfil-instagram').text('1 à ' + tamanhoPagina + ' registros por página ');
                    }

                    function ajustarBotoes() {
                        $('#proximo-perfil-instagram').prop('disabled', data.length <= tamanhoPagina || pagina >= Math.ceil(data.length / tamanhoPagina) - 1);
                        $('#anterior-perfil-instagram').prop('disabled', data.length <= tamanhoPagina || pagina === 0);
                    }

                    $(function () {
                        $('#proximo-perfil-instagram').off('click').on('click', function () {
                            if (pagina < data.length / tamanhoPagina - 1) {
                                $('#tbody-perfil-instagram').empty();
                                pagina++;
                                paginar();
                                ajustarBotoes();
                            }
                        });
                        $('#anterior-perfil-instagram').off('click').on('click', function () {
                            if (pagina >= 1) {
                                $('#tbody-perfil-instagram').empty();
                                pagina--;
                                paginar();
                                ajustarBotoes();
                            }
                        });
                        paginar();
                        ajustarBotoes();
                    });
                },
            });
        },
        toggleAtivo: (uuid, ativo) => {
            $.ajax({
                url: `${admin.baseUrl}/perfil-instagram/${uuid}`,
                type: 'PATCH',
                contentType: 'application/json',
                data: JSON.stringify({ ativo }),
                beforeSend: function () {
                    admin.loading(true);
                },
                success: function () {
                    admin.loading(false);
                    toastr['success']('Status atualizado com sucesso.');
                    perfilInstagramList.list({
                        url: admin.baseUrl + endpoints.perfilInstagram.all,
                        formSearchId: perfilInstagramList.formSearchId,
                    });
                },
                error: function () {
                    admin.loading(false);
                    toastr['error']('Não foi possível atualizar o status.');
                },
            });
        },
        syncInstagram: (uuid) => {
            $.ajax({
                url: `${admin.baseUrl}/perfil-instagram/${uuid}/sync-instagram`,
                type: 'POST',
                beforeSend: function () {
                    admin.loading(true);
                },
                success: function (response) {
                    admin.loading(false);
                    const data = response?.data || {};
                    toastr['success'](`Sync concluído: ${data.totalCreated || 0} criadas, ${data.totalSkipped || 0} ignoradas.`);
                },
                error: function (jqXHR) {
                    admin.loading(false);
                    const msg = jqXHR?.responseJSON?.message || 'Não foi possível sincronizar o perfil.';
                    toastr['error'](msg);
                },
            });
        },
        remove: (uuid) => {
            bootbox.confirm({
                title: 'Atenção',
                message: 'Tem certeza que deseja remover este registro?',
                title: 'Atenção',
                message: 'Tem certeza que deseja remover este registro?',
                buttons: {
                    confirm: {
                        label: '<i class="fa fa-check"></i> Confirmar',
                        className: 'btn-sm btn-success',
                    },
                    cancel: {
                        label: '<i class="fa fa-undo"></i> Cancelar',
                        className: 'btn-sm btn-secondary',
                    },
                },
                callback: function (result) {
                    if (!result) {
                        return;
                    }

                    $.ajax({
                        url: `${admin.baseUrl}/perfil-instagram/${uuid}`,
                        type: 'DELETE',
                        beforeSend: function () {
                            admin.loading(true);
                        },
                        success: function () {
                            admin.loading(false);
                            toastr['success']('Perfil removido com sucesso.');
                            perfilInstagramList.list({
                                url: admin.baseUrl + endpoints.perfilInstagram.all,
                                formSearchId: perfilInstagramList.formSearchId,
                            });
                        },
                        error: function () {
                            admin.loading(false);
                            toastr['error']('Não foi possível remover o perfil.');
                        },
                    });
                },
            });
        },
    };

    window.perfilInstagramList = perfilInstagramList;

    document.getElementById('btn-toggle-barra-perfil-instagram').addEventListener('click', () => {
        const barra = document.getElementById('section-search-bar-perfil-instagram');
        barra.classList.toggle('visible');
    });

    document.getElementById('btn-pesquisar-perfil-instagram').addEventListener('click', () => {
        const barra = document.getElementById('section-search-bar-perfil-instagram');
        barra.classList.toggle('visible');
        perfilInstagramList.list({
            url: admin.baseUrl + endpoints.perfilInstagram.all,
            formSearchId: perfilInstagramList.formSearchId,
        });
    });

    perfilInstagramList.list({
        url: admin.baseUrl + endpoints.perfilInstagram.all,
        formSearchId: perfilInstagramList.formSearchId,
    });
    })();
</script>
