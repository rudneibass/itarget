<section>
    <style>
        .jogo-form-tab-content {
            min-height: calc(100vh - 160px);
            display: flex;
            flex-direction: column;
            padding: .75rem;
            box-shadow: var(--shadows-default);
        }
        .jogo-form-tab-pane {
            display: flex;
            flex-direction: column;
            flex: 1;
            position: relative;
        }
        .jogo-form-main {
            flex: 1;
        }
        .jogo-form-actions {
            position: absolute;
            width: 100%;
            bottom: 0;
            top: auto;
            right: auto;
            z-index: 10;
            display: flex;
            flex-direction: row;
            justify-content: end;
            gap: .5rem;
            margin-top: auto;
            padding-top: .75rem;
            border-top: 1px solid var(--border-color-default);
            background-color: #fff;
        }
        .jogo-form-actions .section-actions-btn-parent {
            width: auto;
        }
        .jogo-form-actions .btn {
            width: 150px;
            height: auto;
            border-radius: .375rem;
            padding: .375rem .75rem;
            gap: .45rem;
            border-radius: 3px!important;
        }

        @media (max-width: 767px) {
            .jogo-form-tab-content {
                min-height: calc(100vh - 130px);
            }

            .jogo-form-actions {
                flex-wrap: wrap;
                justify-content: start;
            }
        }
    </style>
    <div class="col-md-12 p-0">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active text-muted" data-bs-toggle="tab" href="#tab-form-jogo">Cadastro</a>
            </li>
        </ul>
        <div class="tab-content bg-white border border-top-0 jogo-form-tab-content">
            <div class="tab-pane active jogo-form-tab-pane" id="tab-form-jogo">
                <form id="form-jogo" class="jogo-form-main">
                    <input type="hidden" id="uuid" name="uuid" />
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Nome</small>
                                </label>
                                <input type="text" name="nome" class="form-control" id="nome" maxlength="150" required />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Descrição</small>
                                </label>
                                <textarea name="descricao" class="form-control" id="descricao" rows="3"></textarea>
                            </div>
                        </div>
                        <div class="col-md-10">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">URL</small>
                                </label>
                                <input type="url" name="url" class="form-control" id="url" required />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Custo moedas</small>
                                </label>
                                <input type="number" min="0" name="custoMoedas" class="form-control" id="custoMoedas" value="0" />
                            </div>
                        </div>
                    </div>
                </form>

                <section class="section-actions jogo-form-actions">
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-jogo-editar" class="btn btn-secondary btn-float">
                            <i class="fa fa fa-pencil"></i>
                            <span class="btn-label">Editar</span>
                        </button>
                    </div>
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-jogo-salvar" class="btn btn-success btn-float">
                            <i class="fa fa fa-floppy-o"></i>
                            <span class="btn-label">Salvar</span>
                        </button>
                    </div>
                </section>
            </div>
        </div>
    </div>
</section>

<script>
    (() => {
    const jogoForm = {
        formId: 'form-jogo',
        tabId: 'tab-form-jogo',
        setMode: (mode) => {
            const $editButtonParent = $('#btn-jogo-editar').closest('.section-actions-btn-parent');
            const $saveLabel = $('#btn-jogo-salvar .btn-label');
            const $saveIcon = $('#btn-jogo-salvar i');

            if (mode === 'create') {
                $editButtonParent.hide();
                $saveLabel.text('Cadastrar');
                $saveIcon.attr('class', 'fa fa-plus-circle');
                $(`#${jogoForm.formId} :input`).prop('disabled', false);
                return;
            }

            if (mode === 'edit') {
                $editButtonParent.show();
                $saveLabel.text('Salvar');
                $saveIcon.attr('class', 'fa fa-floppy-o');
                $(`#${jogoForm.formId} :input`).prop('disabled', false);
                return;
            }

            $editButtonParent.show();
            $saveLabel.text('Salvar');
            $saveIcon.attr('class', 'fa fa-floppy-o');
            $(`#${jogoForm.formId} :input`).prop('disabled', true);
        },
        edit: () => {
            jogoForm.setMode('edit');
        },
        cancel: () => {
            const uuid = ($(`#${jogoForm.formId} [name="uuid"]`).val() || '').toString().trim();
            if (uuid) {
                jogoForm.setMode('view');
                return;
            }
            jogoForm.setMode('create');
        },
        populateForm: ({ url, uuid = null }) => {
            if (!uuid) {
                jogoForm.setMode('create');
                return;
            }
            $.ajax({
                url: `${url}/${uuid}`,
                type: 'GET',
                dataType: 'json',
                beforeSend: function () {
                    admin.loading(true);
                    jogoForm.setMode('view');
                },
                error: function () {
                    admin.loading(false);
                    toastr['error']('Não foi possível carregar o registro.');
                    jogoForm.setMode('create');
                },
                success: function (response) {
                    admin.loading(false);
                    var data = response?.data || {};
                    var $form = $('#' + jogoForm.formId);

                    $.each(data, function (field, value) {
                        var $field = $form.find('[name="' + field + '"]');
                        if (!$field.length) {
                            $field = $form.find('#' + field);
                        }
                        if (!$field.length) {
                            return;
                        }

                        var fieldType = ($field.attr('type') || '').toLowerCase();
                        var tagName = ($field.get(0)?.tagName || '').toLowerCase();

                        if (fieldType === 'checkbox') {
                            $field.prop('checked', !!value);
                            return;
                        }

                        if (tagName === 'select' || tagName === 'textarea' || fieldType === 'text' || fieldType === 'url' || fieldType === 'number' || fieldType === 'hidden') {
                            $field.val(value ?? '');
                            return;
                        }

                        $field.val(value ?? '');
                    });

                    jogoForm.setMode('view');
                }
            });
        },
        save: ({ formId }) => {
            if ($('#' + formId + ' input').length === $('#' + formId + ' input:disabled').length) {
                return;
            }
            if (!admin.validateForm(formId)) {
                toastr['error']('Preencha os campos obrigatórios.');
                return;
            }

            const $form = $('#' + formId);
            const uuid = ($form.find('[name="uuid"]').val() || '').toString().trim();
            const url = uuid ? `${admin.baseUrl}/jogo/${uuid}` : `${admin.baseUrl}/jogo`;
            const method = uuid ? 'PATCH' : 'POST';

            const formData = $form.serializeArray().reduce(function (obj, item) {
                if (item.name === 'id') {
                    return obj;
                }
                if (item.name === 'uuid' && !item.value) {
                    return obj;
                }
                obj[item.name] = item.value;
                return obj;
            }, {});

            formData.custoMoedas = Number(formData.custoMoedas || 0);

            $.ajax({
                url,
                type: method,
                dataType: 'json',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                beforeSend: function () {
                    admin.loading(true);
                },
                error: function (jqXHR) {
                    admin.loading(false);
                    const msg = jqXHR?.responseJSON?.message || jqXHR?.responseText || 'Não foi possível salvar o registro.';
                    toastr['error'](msg);
                },
                success: function (responseData) {
                    admin.loading(false);
                    var payload = responseData?.data || responseData;

                    if (payload?.uuid && !uuid) {
                        $form.find('[name="uuid"]').val(payload.uuid);
                    }

                    toastr['success']('Operação realizada com sucesso.');
                    jogoForm.cancel('form-jogo');
                }
            });
        }
    };

    window.jogoForm = jogoForm;

    document.getElementById('btn-jogo-editar')?.addEventListener('click', () => {
        jogoForm.edit('form-jogo');
    });

    document.getElementById('btn-jogo-salvar')?.addEventListener('click', () => {
        jogoForm.save({ formId: jogoForm.formId });
    });

    jogoForm.populateForm({
        url: admin.baseUrl + '/jogo',
        uuid: '{{uuid}}'
    });
    })();
</script>
