<section>
    <form id="form-upload-arquivo">
        <input type="hidden" id="idTabelaPai" name="idTabelaPai" value="{{idTabelaPai}}" />
        <input type="hidden" id="tabelaPai" name="tabelaPai" value="{{tabelaPai}}" />

        <div class="mb-3">
            <label class="form-label"><small class="text-muted">Slug (opcional)</small></label>
            <input type="text" class="form-control" id="slug" name="slug" maxlength="255" />
        </div>

        <div class="mb-3">
            <label class="form-label"><small class="text-muted">Arquivo</small></label>
            <input type="file" class="form-control" id="file" name="file" required />
        </div>

        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" onclick="admin.hideModal({ modalId: 'defaultModal' })">Cancelar</button>
            <button type="button" id="btn-upload-arquivo-confirmar" class="btn btn-success">
                <i class="fa fa-upload"></i>
                Enviar arquivo
            </button>
        </div>
    </form>
</section>

<script>
    (() => {
        const $btn = $('#btn-upload-arquivo-confirmar');

        $btn.off('click').on('click', () => {
            const idTabelaPai = ($('#idTabelaPai').val() || '').toString().trim();
            const tabelaPai = ($('#tabelaPai').val() || '').toString().trim();
            const slug = ($('#slug').val() || '').toString().trim();
            const fileInput = document.getElementById('file');
            const file = fileInput?.files?.[0];

            if (!tabelaPai || !idTabelaPai) {
                toastr['error']('Informe a entidade pai para o arquivo.');
                return;
            }

            if (!file) {
                toastr['error']('Selecione um arquivo para envio.');
                return;
            }

            const formData = new FormData();
            formData.append('file', file);

            const query = new URLSearchParams({
                entidadePai: tabelaPai,
                entidadePaiId: idTabelaPai,
                slug,
            });

            $.ajax({
                url: `${admin.baseUrl}/arquivo/upload-local-server?${query.toString()}`,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                beforeSend: () => admin.loading(true),
                error: (jqXHR) => {
                    admin.loading(false);
                    const message = jqXHR?.responseJSON?.message || jqXHR?.responseText || 'Não foi possível enviar o arquivo.';
                    toastr['error'](message);
                },
                success: () => {
                    admin.loading(false);
                    toastr['success']('Arquivo enviado com sucesso.');
                    admin.hideModal({ modalId: 'defaultModal' });
                    document.dispatchEvent(new CustomEvent('admin:arquivo:uploaded'));
                },
            });
        });
    })();
</script>
