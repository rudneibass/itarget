<section>
    <style>
        .organizacao-form-tab-content {
            min-height: calc(100vh - 160px);
            display: flex;
            flex-direction: column;
            padding: .75rem;
            box-shadow: var(--shadows-default);
        }
        .organizacao-form-tab-pane {
            display: flex;
            flex-direction: column;
            flex: 1;
            position: relative;
        }
        .organizacao-form-main {
            flex: 1;
        }
        .organizacao-form-actions {
            position: absolute;
            width: 100%;
            bottom: 0;
            top: auto;
            right: auto;
            z-index: 10;
            display: flex;
            flex-direction: row;
            justify-content: end;
            gap: .5rem;
            margin-top: auto;
            padding-top: .75rem;
            border-top: 1px solid var(--border-color-default);
            background-color: #fff;
        }
        .organizacao-form-actions .section-actions-btn-parent {
            width: auto;
        }
        .organizacao-form-actions .btn {
            width: 150px;
            height: auto;
            border-radius: .375rem;
            padding: .375rem .75rem;
            gap: .45rem;
            border-radius: 3px!important;
        }

        @media (max-width: 767px) {
            .organizacao-form-tab-content {
                min-height: calc(100vh - 130px);
            }

            .organizacao-form-actions {
                flex-wrap: wrap;
                justify-content: start;
            }
        }
    </style>
    <div class="col-md-12 p-0">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active text-muted" data-bs-toggle="tab" href="#tab-form-organizacao">Cadastro</a>
            </li>
        </ul>
        <div class="tab-content bg-white border border-top-0 organizacao-form-tab-content">
            <div class="tab-pane active organizacao-form-tab-pane" id="tab-form-organizacao">
                <form id="form-organizacao" class="organizacao-form-main">
                    <input type="hidden" id="id" name="id" />
                    <input type="hidden" id="uuid" name="uuid" />
                    <div class="row">
                        <div class="col-md-12 ">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Nome</small>
                                </label>
                                <input type="text" name="nome" class="form-control" id="nome" maxlength="200" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Avatar da organização</small>
                                </label>
                                <div class="mb-2">
                                    <img
                                        id="organizacao-avatar-preview"
                                        src=""
                                        alt="Avatar da organização"
                                        style="width: 96px; height: 96px; object-fit: cover; border-radius: 50%; border: 1px solid #ddd; display: none;"
                                    />
                                </div>
                                <input type="file" name="avatarFile" class="form-control" id="avatarFile" accept="image/*" />
                            </div>
                        </div>
                        
                        <!--
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Slug</small>
                                </label>
                                <input type="text" name="slug" class="form-control" id="slug" maxlength="120" />
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="ativo" name="ativo" checked />
                                <label class="form-check-label" for="ativo">Ativa</label>
                            </div>
                        </div>-->
                    </div>
                </form>

                <section class="section-actions organizacao-form-actions">
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-organizacao-editar" class="btn btn-secondary btn-float">
                            <i class="fa fa fa-lock"></i>
                            <span class="btn-label">Editar</span>
                        </button>
                    </div>
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-organizacao-salvar" class="btn btn-success btn-float">
                            <i class="fa fa fa-floppy-o"></i>
                            <span class="btn-label">Salvar</span>
                        </button>
                    </div>
                </section>
            </div>
        </div>
    </div>
</section>

<script>
    (() => {
        const organizacaoForm = {
            formId: 'form-organizacao',
            tabId: 'tab-form-organizacao',
            setAvatarPreview: (url) => {
                const $preview = $('#organizacao-avatar-preview');
                if (!url) {
                    $preview.hide().attr('src', '');
                    return;
                }
                $preview.attr('src', `${url}?t=${Date.now()}`).show();
            },
            loadAvatar: (organizacaoId) => {
                if (!organizacaoId) {
                    organizacaoForm.setAvatarPreview(null);
                    return;
                }

                $.ajax({
                    url: `${admin.baseUrl}/arquivo/avatar`,
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        entidadePai: 'organizacao',
                        entidadePaiId: organizacaoId,
                    },
                    success: function (response) {
                        const avatarUrl = response?.data?.url || null;
                        organizacaoForm.setAvatarPreview(avatarUrl);
                    },
                    error: function () {
                        organizacaoForm.setAvatarPreview(null);
                    },
                });
            },
            uploadAvatar: ({ organizacaoId, onSuccess, onError }) => {
                const input = document.getElementById('avatarFile');
                const file = input?.files?.[0];

                if (!file || !organizacaoId) {
                    if (typeof onSuccess === 'function') {
                        onSuccess(false);
                    }
                    return;
                }

                const formData = new FormData();
                formData.append('file', file);

                $.ajax({
                    url: `${admin.baseUrl}/arquivo/upload-local-server?entidadePai=organizacao&entidadePaiId=${organizacaoId}&slug=avatar`,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function () {
                        $('#avatarFile').val('');
                        organizacaoForm.loadAvatar(organizacaoId);
                        if (typeof onSuccess === 'function') {
                            onSuccess(true);
                        }
                    },
                    error: function (jqXHR) {
                        if (typeof onError === 'function') {
                            onError(jqXHR);
                        }
                    },
                });
            },
            setMode: (mode) => {
                const $editButtonParent = $('#btn-organizacao-editar').closest('.section-actions-btn-parent');
                const $saveLabel = $('#btn-organizacao-salvar .btn-label');
                const $saveIcon = $('#btn-organizacao-salvar i');

                if (mode === 'create') {
                    $editButtonParent.hide();
                    $saveLabel.text('Cadastrar');
                    $saveIcon.attr('class', 'fa fa-plus-circle');
                    $(`#${organizacaoForm.formId} :input`).prop('disabled', false);
                    return;
                }

                if (mode === 'edit') {
                    $editButtonParent.show();
                    $saveLabel.text('Salvar');
                    $saveIcon.attr('class', 'fa fa-floppy-o');
                    $(`#${organizacaoForm.formId} :input`).prop('disabled', false);
                    return;
                }

                $editButtonParent.show();
                $saveLabel.text('Salvar');
                $saveIcon.attr('class', 'fa fa-floppy-o');
                $(`#${organizacaoForm.formId} :input`).prop('disabled', true);
            },
            edit: () => {
                organizacaoForm.setMode('edit');
            },
            cancel: () => {
                const uuid = ($(`#${organizacaoForm.formId} [name="uuid"]`).val() || '').toString().trim();
                if (uuid) {
                    organizacaoForm.setMode('view');
                    return;
                }
                organizacaoForm.setMode('create');
            },
            populateForm: ({ url, uuid = null }) => {
                if (!uuid) {
                    organizacaoForm.setMode('create');
                    organizacaoForm.setAvatarPreview(null);
                    return;
                }
                $.ajax({
                    url: `${url}/${uuid}`,
                    type: 'GET',
                    dataType: 'json',
                    beforeSend: function () {
                        admin.loading(true);
                        organizacaoForm.setMode('view');
                    },
                    error: function () {
                        admin.loading(false);
                        toastr['error']('Não foi possível carregar o registro.');
                        organizacaoForm.setMode('create');
                    },
                    success: function (response) {
                        admin.loading(false);
                        var data = response?.data || {};
                        var $form = $('#' + organizacaoForm.formId);
                        $.each(data, function (field, value) {
                            var $field = $form.find('[name="' + field + '"]');
                            if (!$field.length) {
                                $field = $form.find('#' + field);
                            }
                            if (!$field.length) {
                                return;
                            }
                            var fieldType = ($field.attr('type') || '').toLowerCase();
                            var tagName = ($field.get(0)?.tagName || '').toLowerCase();
                            if (fieldType === 'checkbox') {
                                $field.prop('checked', !!value);
                                return;
                            }
                            if (tagName === 'select' || tagName === 'textarea' || fieldType === 'text' || fieldType === 'hidden') {
                                $field.val(value ?? '');
                                return;
                            }
                            $field.val(value ?? '');
                        });
                        organizacaoForm.loadAvatar(data.id);
                        organizacaoForm.setMode('view');
                    }
                });
            },
            save: ({ formId }) => {
                if ($('#' + formId + ' input').length === $('#' + formId + ' input:disabled').length) {
                    return;
                }
                if (!admin.validateForm(formId)) {
                    toastr['error']('Preencha os campos obrigatórios.');
                    return;
                }
                const $form = $('#' + formId);
                const uuid = ($form.find('[name="uuid"]').val() || '').toString().trim();
                const url = uuid ? `${admin.baseUrl}/organizacao/${uuid}` : `${admin.baseUrl}/organizacao`;
                const method = uuid ? 'PATCH' : 'POST';
                const formData = $form.serializeArray().reduce(function (obj, item) {
                    if (item.name === 'id') {
                        return obj;
                    }
                    if (item.name === 'uuid' && !item.value) {
                        return obj;
                    }
                    obj[item.name] = item.value;
                    return obj;
                }, {});

                $.ajax({
                    url,
                    type: method,
                    dataType: 'json',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    beforeSend: function () {
                        admin.loading(true);
                    },
                    error: function (jqXHR) {
                        admin.loading(false);
                        toastr['error'](jqXHR?.responseText || 'Não foi possível salvar o registro.');
                    },
                    success: function (responseData) {
                        admin.loading(false);
                        var payload = responseData?.data || responseData;
                        if (payload?.uuid && !uuid) {
                            $form.find('[name="uuid"]').val(payload.uuid);
                        }
                        if (payload?.id) {
                            $form.find('[name="id"]').val(payload.id);
                        }

                        const persistedId = Number($form.find('[name="id"]').val() || payload?.id || 0);

                        organizacaoForm.uploadAvatar({
                            organizacaoId: persistedId,
                            onSuccess: (uploaded) => {
                                if (uploaded) {
                                    toastr['success']('Dados e avatar salvos com sucesso.');
                                } else {
                                    toastr['success']('Operação realizada com sucesso.');
                                }
                                organizacaoForm.cancel('form-organizacao');
                            },
                            onError: (jqXHR) => {
                                const message = jqXHR?.responseJSON?.message || jqXHR?.responseText || 'Dados salvos, mas o upload do avatar falhou.';
                                toastr['warning'](message);
                                organizacaoForm.cancel('form-organizacao');
                            },
                        });
                    }
                });
            }
        };

        window.organizacaoForm = organizacaoForm;

        document.getElementById('btn-organizacao-editar')?.addEventListener('click', () => {
            organizacaoForm.edit('form-organizacao');
        });

        document.getElementById('btn-organizacao-salvar')?.addEventListener('click', () => {
            organizacaoForm.save({ formId: organizacaoForm.formId });
        });

        organizacaoForm.populateForm({
            url: admin.baseUrl + '/organizacao',
            uuid: '{{uuid}}'
        });
    })();
</script>
