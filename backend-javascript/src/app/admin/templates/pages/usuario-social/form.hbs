<section>
    <style>
        .usuario-social-form-tab-content {
            min-height: calc(100vh - 160px);
            display: flex;
            flex-direction: column;
            padding: .75rem;
            box-shadow: var(--shadows-default);
        }
        .usuario-social-form-tab-pane {
            display: flex;
            flex-direction: column;
            flex: 1;
            position: relative;
        }
        .usuario-social-form-main {
            flex: 1;
        }
        .usuario-social-form-actions {
            position: absolute;
            width: 100%;
            bottom: 0;
            top: auto;
            right: auto;
            z-index: 10;
            display: flex;
            flex-direction: row;
            justify-content: end;
            gap: .5rem;
            margin-top: auto;
            padding-top: .75rem;
            border-top: 1px solid var(--border-color-default);
            background-color: #fff;
        }
        .usuario-social-form-actions .section-actions-btn-parent {
            width: auto;
        }
        .usuario-social-form-actions .btn {
            width: 150px;
            height: auto;
            border-radius: .375rem;
            padding: .375rem .75rem;
            gap: .45rem;
            border-radius: 3px!important;
        }

        @media (max-width: 767px) {
            .usuario-social-form-tab-content {
                min-height: calc(100vh - 130px);
            }

            .usuario-social-form-actions {
                flex-wrap: wrap;
                justify-content: start;
            }
        }
    </style>
    <div class="col-md-12 p-0">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active text-muted" data-bs-toggle="tab" href="#tab-form-usuario-social">Cadastro</a>
            </li>
        </ul>
        <div class="tab-content bg-white border border-top-0 usuario-social-form-tab-content">
            <div class="tab-pane active usuario-social-form-tab-pane" id="tab-form-usuario-social">
                <form id="form-usuario-social" class="usuario-social-form-main">
                    <input type="hidden" id="id" name="id" />
                    <input type="hidden" id="uuid" name="uuid" />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Nome</small>
                                </label>
                                <input type="text" name="nome" class="form-control" id="nome" maxlength="255" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Apelido</small>
                                </label>
                                <input type="text" name="apelido" class="form-control" id="apelido" maxlength="120" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Moedas</small>
                                </label>
                                <input type="number" min="0" name="moedas" class="form-control" id="moedas" value="0" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Status</small>
                                </label>
                                <select name="ativo" class="form-select" id="ativo" required>
                                    <option value="true">Ativo</option>
                                    <option value="false">Inativo</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Avatar</small>
                                </label>
                                <div class="mb-2">
                                    <img
                                        id="usuario-social-avatar-preview"
                                        src=""
                                        alt="Avatar do usuário"
                                        style="width: 96px; height: 96px; object-fit: cover; border-radius: 50%; border: 1px solid #ddd; display: none;"
                                    />
                                </div>
                                <input type="file" name="avatarFile" class="form-control" id="avatarFile" accept="image/*" />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-check form-check-inline mb-2">
                                <input type="checkbox" class="form-check-input" id="podePostarMidia" name="podePostarMidia" />
                                <label class="form-check-label" for="podePostarMidia">Pode postar mídia</label>
                            </div>
                            <div class="form-check form-check-inline mb-2">
                                <input type="checkbox" class="form-check-input" id="podePostarLink" name="podePostarLink" />
                                <label class="form-check-label" for="podePostarLink">Pode postar link</label>
                            </div>
                        </div>
                    </div>
                </form>

                <section class="section-actions usuario-social-form-actions">
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-usuario-social-editar" class="btn btn-secondary btn-float">
                            <i class="fa fa fa-pencil"></i>
                            <span class="btn-label">Editar</span>
                        </button>
                    </div>
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-usuario-social-salvar" class="btn btn-success btn-float">
                            <i class="fa fa fa-floppy-o"></i>
                            <span class="btn-label">Salvar</span>
                        </button>
                    </div>
                </section>
            </div>
        </div>
    </div>
</section>

<script>
    (() => {
    const usuarioSocialForm = {
        formId: 'form-usuario-social',
        setAvatarPreview: (url) => {
            const $preview = $('#usuario-social-avatar-preview');
            if (!url) {
                $preview.hide().attr('src', '');
                return;
            }
            $preview.attr('src', `${url}?t=${Date.now()}`).show();
        },
        loadAvatar: (usuarioId) => {
            if (!usuarioId) {
                usuarioSocialForm.setAvatarPreview(null);
                return;
            }

            $.ajax({
                url: `${admin.baseUrl}/arquivo/avatar`,
                type: 'GET',
                dataType: 'json',
                data: {
                    entidadePai: 'usuario',
                    entidadePaiId: usuarioId,
                },
                success: function (response) {
                    const avatarUrl = response?.data?.url || null;
                    usuarioSocialForm.setAvatarPreview(avatarUrl);
                },
                error: function () {
                    usuarioSocialForm.setAvatarPreview(null);
                },
            });
        },
        uploadAvatar: ({ usuarioId, onSuccess, onError }) => {
            const input = document.getElementById('avatarFile');
            const file = input?.files?.[0];

            if (!file || !usuarioId) {
                if (typeof onSuccess === 'function') {
                    onSuccess(false);
                }
                return;
            }

            const formData = new FormData();
            formData.append('file', file);

            $.ajax({
                url: `${admin.baseUrl}/arquivo/upload-local-server?entidadePai=usuario&entidadePaiId=${usuarioId}&slug=avatar`,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function () {
                    $('#avatarFile').val('');
                    usuarioSocialForm.loadAvatar(usuarioId);
                    if (typeof onSuccess === 'function') {
                        onSuccess(true);
                    }
                },
                error: function (jqXHR) {
                    if (typeof onError === 'function') {
                        onError(jqXHR);
                    }
                },
            });
        },
        setMode: (mode) => {
            const $editButtonParent = $('#btn-usuario-social-editar').closest('.section-actions-btn-parent');
            const $saveLabel = $('#btn-usuario-social-salvar .btn-label');
            const $saveIcon = $('#btn-usuario-social-salvar i');

            if (mode === 'create') {
                $editButtonParent.hide();
                $saveLabel.text('Cadastrar');
                $saveIcon.attr('class', 'fa fa-plus-circle');
                $(`#${usuarioSocialForm.formId} :input`).prop('disabled', false);
                return;
            }

            if (mode === 'edit') {
                $editButtonParent.show();
                $saveLabel.text('Salvar');
                $saveIcon.attr('class', 'fa fa-floppy-o');
                $(`#${usuarioSocialForm.formId} :input`).prop('disabled', false);
                return;
            }

            $editButtonParent.show();
            $saveLabel.text('Salvar');
            $saveIcon.attr('class', 'fa fa-floppy-o');
            $(`#${usuarioSocialForm.formId} :input`).prop('disabled', true);
        },
        edit: () => {
            usuarioSocialForm.setMode('edit');
        },
        cancel: () => {
            const uuid = ($(`#${usuarioSocialForm.formId} [name="uuid"]`).val() || '').toString().trim();
            if (uuid) {
                usuarioSocialForm.setMode('view');
                return;
            }
            usuarioSocialForm.setMode('create');
        },
        populateForm: ({ url, uuid = null }) => {
            if (!uuid) {
                usuarioSocialForm.setMode('create');
                usuarioSocialForm.setAvatarPreview(null);
                return;
            }
            $.ajax({
                url: `${url}/${uuid}`,
                type: 'GET',
                dataType: 'json',
                beforeSend: function () {
                    admin.loading(true);
                    usuarioSocialForm.setMode('view');
                },
                error: function () {
                    admin.loading(false);
                    toastr['error']('Não foi possível carregar o registro.');
                    usuarioSocialForm.setMode('create');
                },
                success: function (response) {
                    admin.loading(false);
                    var data = response?.data || {};
                    var $form = $('#' + usuarioSocialForm.formId);

                    $form.find('[name="id"]').val(data.id || '');
                    $form.find('[name="uuid"]').val(data.uuid || '');
                    $form.find('[name="nome"]').val(data.nome || '');
                    $form.find('[name="apelido"]').val(data.apelido || '');
                    $form.find('[name="moedas"]').val(Number(data.moedas || 0));
                    $form.find('[name="ativo"]').val(String(data.ativo !== false));
                    $form.find('[name="podePostarMidia"]').prop('checked', !!data.podePostarMidia);
                    $form.find('[name="podePostarLink"]').prop('checked', !!data.podePostarLink);

                    usuarioSocialForm.loadAvatar(data.id);
                    usuarioSocialForm.setMode('view');
                }
            });
        },
        save: ({ formId }) => {
            if ($('#' + formId + ' input').length === $('#' + formId + ' input:disabled').length) {
                return;
            }
            if (!admin.validateForm(formId)) {
                toastr['error']('Preencha os campos obrigatórios.');
                return;
            }

            const $form = $('#' + formId);
            const uuid = ($form.find('[name="uuid"]').val() || '').toString().trim();
            const url = uuid ? `${admin.baseUrl}/usuario-social/${uuid}` : `${admin.baseUrl}/usuario-social`;
            const method = uuid ? 'PATCH' : 'POST';

            const formData = {
                nome: ($form.find('[name="nome"]').val() || '').toString().trim(),
                apelido: ($form.find('[name="apelido"]').val() || '').toString().trim() || null,
                moedas: Number($form.find('[name="moedas"]').val() || 0),
                ativo: String($form.find('[name="ativo"]').val()) === 'true',
                podePostarMidia: $form.find('[name="podePostarMidia"]').is(':checked'),
                podePostarLink: $form.find('[name="podePostarLink"]').is(':checked'),
            };

            $.ajax({
                url,
                type: method,
                dataType: 'json',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                beforeSend: function () {
                    admin.loading(true);
                },
                error: function (jqXHR) {
                    admin.loading(false);
                    const msg = jqXHR?.responseJSON?.message || jqXHR?.responseText || 'Não foi possível salvar o registro.';
                    toastr['error'](Array.isArray(msg) ? msg.join(', ') : msg);
                },
                success: function (responseData) {
                    admin.loading(false);
                    var payload = responseData?.data || responseData;

                    if (payload?.uuid && !uuid) {
                        $form.find('[name="uuid"]').val(payload.uuid);
                    }

                    if (payload?.id) {
                        $form.find('[name="id"]').val(payload.id);
                    }

                    const persistedId = Number($form.find('[name="id"]').val() || payload?.id || 0);
                    usuarioSocialForm.uploadAvatar({
                        usuarioId: persistedId,
                        onSuccess: (uploaded) => {
                            if (uploaded) {
                                toastr['success']('Dados e avatar salvos com sucesso.');
                            } else {
                                toastr['success']('Operação realizada com sucesso.');
                            }
                            usuarioSocialForm.cancel('form-usuario-social');
                        },
                        onError: (jqXHR) => {
                            const message = jqXHR?.responseJSON?.message || jqXHR?.responseText || 'Dados salvos, mas o upload do avatar falhou.';
                            toastr['warning'](message);
                            usuarioSocialForm.cancel('form-usuario-social');
                        },
                    });
                }
            });
        }
    };

    window.usuarioSocialForm = usuarioSocialForm;

    document.getElementById('btn-usuario-social-editar')?.addEventListener('click', () => {
        usuarioSocialForm.edit('form-usuario-social');
    });

    document.getElementById('btn-usuario-social-salvar')?.addEventListener('click', () => {
        usuarioSocialForm.save({ formId: usuarioSocialForm.formId });
    });

    usuarioSocialForm.populateForm({
        url: admin.baseUrl + '/usuario-social',
        uuid: '{{uuid}}'
    });
    })();
</script>
