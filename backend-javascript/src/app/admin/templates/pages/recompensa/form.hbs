<section>
    <style>
        .recompensa-form-tab-content {
            min-height: calc(100vh - 160px);
            display: flex;
            flex-direction: column;
            padding: .75rem;
            box-shadow: var(--shadows-default);
        }
        .recompensa-form-tab-pane {
            display: flex;
            flex-direction: column;
            flex: 1;
            position: relative;
        }
        .recompensa-form-main {
            flex: 1;
        }
        .recompensa-form-actions {
            position: absolute;
            width: 100%;
            bottom: 0;
            top: auto;
            right: auto;
            z-index: 10;
            display: flex;
            flex-direction: row;
            justify-content: end;
            gap: .5rem;
            margin-top: auto;
            padding-top: .75rem;
            border-top: 1px solid var(--border-color-default);
            background-color: #fff;
        }
        .recompensa-form-actions .section-actions-btn-parent {
            width: auto;
        }
        .recompensa-form-actions .btn {
            width: 150px;
            height: auto;
            border-radius: .375rem;
            padding: .375rem .75rem;
            gap: .45rem;
            border-radius: 3px!important;
        }

        @media (max-width: 767px) {
            .recompensa-form-tab-content {
                min-height: calc(100vh - 130px);
            }

            .recompensa-form-actions {
                flex-wrap: wrap;
                justify-content: start;
            }
        }
    </style>
    <div class="col-md-12 p-0">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active text-muted" data-bs-toggle="tab" href="#tab-form-recompensa">Cadastro</a>
            </li>
        </ul>
        <div class="tab-content bg-white border border-top-0 recompensa-form-tab-content">
            <div class="tab-pane active recompensa-form-tab-pane" id="tab-form-recompensa">
                <form id="form-recompensa" class="recompensa-form-main">
                    <input type="hidden" id="uuid" name="uuid" />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Organização</small>
                                </label>
                                <select name="organizacaoUuid" class="form-select" id="organizacaoUuid" required></select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Título</small>
                                </label>
                                <input type="text" name="titulo" class="form-control" id="titulo" maxlength="150" required />
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Descrição</small>
                                </label>
                                <textarea name="descricao" class="form-control" id="descricao" rows="3" required></textarea>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Tipo</small>
                                </label>
                                <input type="text" name="tipo" class="form-control" id="tipo" required />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Custo moedas</small>
                                </label>
                                <input type="number" min="0" name="custoMoedas" class="form-control" id="custoMoedas" value="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" id="ativo" name="ativo" checked />
                                <label class="form-check-label" for="ativo">Ativa</label>
                            </div>
                        </div>
                    </div>
                </form>

                <section class="section-actions recompensa-form-actions">
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-recompensa-editar" class="btn btn-secondary btn-float">
                            <i class="fa fa fa-pencil"></i>
                            <span class="btn-label">Editar</span>
                        </button>
                    </div>
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-recompensa-salvar" class="btn btn-success btn-float">
                            <i class="fa fa fa-floppy-o"></i>
                            <span class="btn-label">Salvar</span>
                        </button>
                    </div>
                </section>
            </div>
        </div>
    </div>
</section>

<script>
    (() => {
    const recompensaForm = {
        formId: 'form-recompensa',
        tabId: 'tab-form-recompensa',
        setMode: (mode) => {
            const $editButtonParent = $('#btn-recompensa-editar').closest('.section-actions-btn-parent');
            const $saveLabel = $('#btn-recompensa-salvar .btn-label');
            const $saveIcon = $('#btn-recompensa-salvar i');

            if (mode === 'create') {
                $editButtonParent.hide();
                $saveLabel.text('Cadastrar');
                $saveIcon.attr('class', 'fa fa-plus-circle');
                $(`#${recompensaForm.formId} :input`).prop('disabled', false);
                return;
            }

            if (mode === 'edit') {
                $editButtonParent.show();
                $saveLabel.text('Salvar');
                $saveIcon.attr('class', 'fa fa-floppy-o');
                $(`#${recompensaForm.formId} :input`).prop('disabled', false);
                return;
            }

            $editButtonParent.show();
            $saveLabel.text('Salvar');
            $saveIcon.attr('class', 'fa fa-floppy-o');
            $(`#${recompensaForm.formId} :input`).prop('disabled', true);
        },
        edit: () => {
            recompensaForm.setMode('edit');
        },
        cancel: () => {
            const uuid = ($(`#${recompensaForm.formId} [name="uuid"]`).val() || '').toString().trim();
            if (uuid) {
                recompensaForm.setMode('view');
                return;
            }
            recompensaForm.setMode('create');
        },
        loadOrganizations: (callback) => {
            $.ajax({
                url: `${admin.baseUrl}/recompensa/organizacoes`,
                type: 'GET',
                success: (response) => {
                    const list = response?.data || [];
                    const $select = $(`#${recompensaForm.formId} [name="organizacaoUuid"]`);
                    $select.empty();
                    $select.append('<option value="">Selecione...</option>');
                    list.forEach((item) => {
                        $select.append(`<option value="${item.uuid}">${item.nome}</option>`);
                    });
                    if (typeof callback === 'function') {
                        callback();
                    }
                },
                error: () => toastr['error']('Erro ao carregar organizações.'),
            });
        },
        populateForm: ({ url, uuid = null }) => {
            if (!uuid) {
                recompensaForm.setMode('create');
                return;
            }
            $.ajax({
                url: `${url}/${uuid}`,
                type: 'GET',
                dataType: 'json',
                beforeSend: function () {
                    admin.loading(true);
                    recompensaForm.setMode('view');
                },
                error: function () {
                    admin.loading(false);
                    toastr['error']('Não foi possível carregar o registro.');
                    recompensaForm.setMode('create');
                },
                success: function (response) {
                    admin.loading(false);
                    var data = response?.data || {};
                    var $form = $('#' + recompensaForm.formId);

                    $.each(data, function (field, value) {
                        var $field = $form.find('[name="' + field + '"]');
                        if (!$field.length) {
                            $field = $form.find('#' + field);
                        }
                        if (!$field.length) {
                            return;
                        }

                        var fieldType = ($field.attr('type') || '').toLowerCase();
                        var tagName = ($field.get(0)?.tagName || '').toLowerCase();

                        if (fieldType === 'checkbox') {
                            $field.prop('checked', !!value);
                            return;
                        }

                        if (tagName === 'select' || tagName === 'textarea' || fieldType === 'text' || fieldType === 'number' || fieldType === 'hidden') {
                            $field.val(value ?? '');
                            return;
                        }

                        $field.val(value ?? '');
                    });

                    recompensaForm.setMode('view');
                }
            });
        },
        save: ({ formId }) => {
            if ($('#' + formId + ' input').length === $('#' + formId + ' input:disabled').length) {
                return;
            }
            if (!admin.validateForm(formId)) {
                toastr['error']('Preencha os campos obrigatórios.');
                return;
            }

            const $form = $('#' + formId);
            const uuid = ($form.find('[name="uuid"]').val() || '').toString().trim();
            const url = uuid ? `${admin.baseUrl}/recompensa/${uuid}` : `${admin.baseUrl}/recompensa`;
            const method = uuid ? 'PATCH' : 'POST';

            const formData = $form.serializeArray().reduce(function (obj, item) {
                if (item.name === 'id') {
                    return obj;
                }
                if (item.name === 'uuid' && !item.value) {
                    return obj;
                }
                obj[item.name] = item.value;
                return obj;
            }, {});

            formData.ativo = $form.find('[name="ativo"]').is(':checked');
            formData.custoMoedas = Number(formData.custoMoedas || 0);

            $.ajax({
                url,
                type: method,
                dataType: 'json',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                beforeSend: function () {
                    admin.loading(true);
                },
                error: function (jqXHR) {
                    admin.loading(false);
                    toastr['error'](jqXHR?.responseText || 'Não foi possível salvar o registro.');
                },
                success: function (responseData) {
                    admin.loading(false);
                    var payload = responseData?.data || responseData;

                    if (payload?.uuid && !uuid) {
                        $form.find('[name="uuid"]').val(payload.uuid);
                    }

                    toastr['success']('Operação realizada com sucesso.');
                    recompensaForm.cancel('form-recompensa');
                }
            });
        }
    };

    window.recompensaForm = recompensaForm;

    document.getElementById('btn-recompensa-editar')?.addEventListener('click', () => {
        recompensaForm.edit('form-recompensa');
    });

    document.getElementById('btn-recompensa-salvar')?.addEventListener('click', () => {
        recompensaForm.save({ formId: recompensaForm.formId });
    });

    recompensaForm.loadOrganizations(() => {
        recompensaForm.populateForm({
            url: admin.baseUrl + '/recompensa',
            uuid: '{{uuid}}'
        });
    });
    })();
</script>
