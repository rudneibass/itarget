<section class="section-actions">
    <div class="section-actions-btn-parent">
        <button
            class="btn btn-success btn-float section-actions-btn"
            onclick="admin.addTab({tabId:'form-recompensa', title: 'Nova Recompensa', url: '/admin/recompensa/form'})"
        >
            <i class="fa fa-plus"></i>
            <span class="btn-label">Novo</span>
        </button>
    </div>
    <div class="section-actions-btn-parent">
        <button class="btn btn-warning btn-float section-actions-btn" id="btn-toggle-barra-recompensa">
            <i class="fa fa-search"></i>
            <span class="btn-label">Pesquisar</span>
        </button>
    </div>
</section>

<section class="section-search-bar hide" id="section-search-bar-recompensa">
    <div class="row search-bar" id="search-bar-recompensa">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-success-light"><span class="text-muted">Pesquisa por...</span></div>
                <div class="card-body">
                    <form id="formSearchRecompensa">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="input-group mb-3">
                                    <input type="text" name="titulo" id="titulo" class="form-control" placeholder="Título">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="input-group mb-3">
                                    <input type="text" name="tipo" id="tipo" class="form-control" placeholder="Tipo">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="input-group mb-3">
                                    <select name="ativo" id="ativo" class="form-select">
                                        <option value="">Status</option>
                                        <option value="true">Ativa</option>
                                        <option value="false">Inativa</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer p-2 border-top-0">
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-pesquisar-recompensa">
                        <i class="fa fa-search"></i> Pesquisar
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="page-info-bar shadows-default">
        <small><i class="fa fa-gift"></i></small>
        <small>Recompensas</small>
    </div>
</section>

<section>
    <div class="list-table-container">
        <table class="table table-sm table-striped table-hover width-100">
            <thead id="thead-recompensa"></thead>
            <tbody id="tbody-recompensa"></tbody>
        </table>
        <div class="text-center">
            <span class="pt-5" id="messages-recompensa"></span>
        </div>
    </div>
    <div class="pagination-bar-default">
        <div>
            <small class="gray-default" id="total-recompensa"></small>
        </div>
        <div>
            <i class="fa fa-chevron-left gray-default cursor-pointer" id="anterior-recompensa"></i>
            &emsp;
            <span class="gray-default" id="numeracao-recompensa"></span>
            &emsp;
            <i class="fa fa-chevron-right gray-default cursor-pointer" id="proximo-recompensa"></i>
        </div>
    </div>
</section>

<script>
    (() => {
    const recompensaList = {
        formSearchId: 'formSearchRecompensa',
        list: ({ url, formSearchId }) => {
            $.ajax({
                url,
                cache: false,
                type: 'GET',
                data: $('#' + formSearchId).serialize(),
                dataType: 'json',
                beforeSend: function () {
                    $('#messages-recompensa').empty();
                    $('#tbody-recompensa').empty();
                    admin.loading(true);
                },
                error: function () {
                    admin.loading(false);
                    $('#tbody-recompensa').empty();
                    $('#messages-recompensa').empty();
                    $('#messages-recompensa').html("<h6 class='text-muted text-center'>Não foi possivel executar a ação desejada, favor entrar em contato com o administrador.</h6>");
                },
                success: function (response) {
                    var source = response?.data || response || [];
                    var filters = $('#' + formSearchId).serializeArray().reduce((obj, item) => {
                        obj[item.name] = item.value;
                        return obj;
                    }, {});

                    var data = source.filter((item) => {
                        const byTitulo = !filters.titulo || String(item.titulo || '').toLowerCase().includes(String(filters.titulo).toLowerCase());
                        const byTipo = !filters.tipo || String(item.tipo || '').toLowerCase().includes(String(filters.tipo).toLowerCase());
                        const byAtivo = !filters.ativo || String(!!item.ativo) === String(filters.ativo);
                        return byTitulo && byTipo && byAtivo;
                    });

                    if (!data[0]) {
                        admin.loading(false);
                        $('#tbody-recompensa').empty();
                        $('#messages-recompensa').empty();
                        $('#messages-recompensa').html("<br/><br/><h6 class='text-muted text-center'>Consulta não obteve resultados.</h6>");
                        return;
                    }

                    admin.loading(false);
                    $('#tbody-recompensa').empty();
                    $('#messages-recompensa').empty();

                    var tamanhoPagina = 10;
                    var pagina = 0;

                    function paginar() {
                        for (var i = pagina * tamanhoPagina; i < data.length && i < (pagina + 1) * tamanhoPagina; i++) {
                            $('#tbody-recompensa').append(
                                `<tr>
                                    <td class="p-3" style="width:90%; vertical-align: middle;">
                                        <div>
                                            <small>
                                                <b>Título:</b> ${data[i].titulo || ''}
                                                ${data[i].ativo
                                                    ? '&emsp;<span class="badge bg-success">Ativa</span>'
                                                    : '&emsp;<span class="badge bg-secondary">Inativa</span>'
                                                }
                                            </small>
                                            <br/>
                                            <small><b>Descrição:</b> ${data[i].descricao || '-'}</small>
                                            <br/>
                                            <small><b>Tipo:</b> ${data[i].tipo || '-'}</small>
                                            <br/>
                                            <small><b>Custo em moedas:</b> ${data[i].custoMoedas ?? 0}</small>
                                            <br/>
                                            <small><b>Código:</b> ${data[i].uuid || ''}</small>
                                        </div>
                                    </td>
                                    <td style="width: 8%; vertical-align: middle;">
                                        <center>
                                            <button
                                                class="btn btn-secondary btn-sm w-100 mb-2"
                                                onclick="admin.addTab({tabId:'form-recompensa', title: 'Editar Recompensa', url: '/admin/recompensa/form/uuid/${data[i].uuid}'})"
                                            >
                                                <i class="fa fa-pencil"></i> Editar
                                            </button>
                                            ${data[i].ativo
                                                ? `<button class="btn btn-secondary btn-sm w-100 mb-2" onclick="recompensaList.toggleAtivo('${data[i].uuid}', false)">
                                                    <i class="fa fa-download"></i> Desativar
                                                </button>`
                                                : `<button class="btn btn-secondary btn-sm w-100 mb-2" onclick="recompensaList.toggleAtivo('${data[i].uuid}', true)">
                                                    <i class="fa fa-upload"></i> Ativar
                                                </button>`
                                            }
                                            <button class="btn btn-secondary btn-sm w-100 mb-2" onclick="recompensaList.remove('${data[i].uuid}')">
                                                <i class="fa fa-trash-o"></i>
                                                <span> Excluir</span>
                                            </button>
                                        </center>
                                    </td>
                                </tr>`
                            );
                        }
                        $('#numeracao-recompensa').text('Página ' + (pagina + 1) + ' de ' + Math.ceil(data.length / tamanhoPagina));
                        $('#total-recompensa').text('1 à ' + tamanhoPagina + ' registros por página ');
                    }

                    function ajustarBotoes() {
                        $('#proximo-recompensa').prop('disabled', data.length <= tamanhoPagina || pagina >= Math.ceil(data.length / tamanhoPagina) - 1);
                        $('#anterior-recompensa').prop('disabled', data.length <= tamanhoPagina || pagina === 0);
                    }

                    $(function () {
                        $('#proximo-recompensa').off('click').on('click', function () {
                            if (pagina < data.length / tamanhoPagina - 1) {
                                $('#tbody-recompensa').empty();
                                pagina++;
                                paginar();
                                ajustarBotoes();
                            }
                        });
                        $('#anterior-recompensa').off('click').on('click', function () {
                            if (pagina >= 1) {
                                $('#tbody-recompensa').empty();
                                pagina--;
                                paginar();
                                ajustarBotoes();
                            }
                        });
                        paginar();
                        ajustarBotoes();
                    });
                },
            });
        },
        toggleAtivo: (uuid, ativo) => {
            $.ajax({
                url: `${admin.baseUrl}/recompensa/${uuid}`,
                type: 'PATCH',
                contentType: 'application/json',
                data: JSON.stringify({ ativo }),
                beforeSend: function () {
                    admin.loading(true);
                },
                success: function () {
                    admin.loading(false);
                    toastr['success']('Status atualizado com sucesso.');
                    recompensaList.list({
                        url: admin.baseUrl + endpoints.recompensa.all,
                        formSearchId: recompensaList.formSearchId,
                    });
                },
                error: function () {
                    admin.loading(false);
                    toastr['error']('Não foi possível atualizar o status.');
                },
            });
        },
        remove: (uuid) => {
            bootbox.confirm({
                title: 'Atenção',
                message: 'Tem certeza que deseja remover este registro?',
                buttons: {
                    confirm: {
                        label: '<i class="fa fa-check"></i> Confirmar',
                        className: 'btn-sm btn-success',
                    },
                    cancel: {
                        label: '<i class="fa fa-undo"></i> Cancelar',
                        className: 'btn-sm btn-secondary',
                    },
                },
                callback: function (result) {
                    if (!result) {
                        return;
                    }

                    $.ajax({
                        url: `${admin.baseUrl}/recompensa/${uuid}`,
                        type: 'DELETE',
                        beforeSend: function () {
                            admin.loading(true);
                        },
                        success: function () {
                            admin.loading(false);
                            toastr['success']('Recompensa removida com sucesso.');
                            recompensaList.list({
                                url: admin.baseUrl + endpoints.recompensa.all,
                                formSearchId: recompensaList.formSearchId,
                            });
                        },
                        error: function () {
                            admin.loading(false);
                            toastr['error']('Não foi possível remover a recompensa.');
                        },
                    });
                },
            });
        },
    };

    window.recompensaList = recompensaList;

    document.getElementById('btn-toggle-barra-recompensa').addEventListener('click', () => {
        const barra = document.getElementById('section-search-bar-recompensa');
        barra.classList.toggle('visible');
    });

    document.getElementById('btn-pesquisar-recompensa').addEventListener('click', () => {
        const barra = document.getElementById('section-search-bar-recompensa');
        barra.classList.toggle('visible');
        recompensaList.list({
            url: admin.baseUrl + endpoints.recompensa.all,
            formSearchId: recompensaList.formSearchId,
        });
    });

    recompensaList.list({
        url: admin.baseUrl + endpoints.recompensa.all,
        formSearchId: recompensaList.formSearchId,
    });
    })();
</script>
