<section>
    <style>
        .video-form-tab-content {
            min-height: calc(100vh - 160px);
            display: flex;
            flex-direction: column;
            padding: .75rem;
            box-shadow: var(--shadows-default);
        }
        .video-form-tab-pane {
            display: flex;
            flex-direction: column;
            flex: 1;
            position: relative;
        }
        .video-form-main {
            flex: 1;
        }
        .video-form-actions {
            position: absolute;
            width: 100%;
            bottom: 0;
            top: auto;
            right: auto;
            z-index: 10;
            display: flex;
            flex-direction: row;
            justify-content: end;
            gap: .5rem;
            margin-top: auto;
            padding-top: .75rem;
            border-top: 1px solid var(--border-color-default);
            background-color: #fff;
        }
        .video-form-actions .section-actions-btn-parent {
            width: auto;
        }
        .video-form-actions .btn {
            width: 150px;
            height: auto;
            border-radius: .375rem;
            padding: .375rem .75rem;
            gap: .45rem;
            border-radius: 3px!important;
        }

        @media (max-width: 767px) {
            .video-form-tab-content {
                min-height: calc(100vh - 130px);
            }

            .video-form-actions {
                flex-wrap: wrap;
                justify-content: start;
            }
        }
    </style>
    <div class="col-md-12 p-0">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active text-muted" data-bs-toggle="tab" href="#tab-form-video">Cadastro</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#tab-video-arquivos">Arquivos</a>
            </li>
        </ul>
        <!-- Tab panes -->
        <div class="tab-content bg-white border border-top-0 video-form-tab-content">
            <div class="tab-pane active video-form-tab-pane" id="tab-form-video">
                <form id="form-video" class="video-form-main">
                    <input type="hidden" id="uuid" name="uuid" />
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Data</small>
                                </label>	
                                <input type="date" name="data" class="form-control" id="data" required/>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group mb-3">	
                                <label> 
                                    <small class="text-muted">Título</small>
                                </label>
                                <input type="text" name="titulo" class="form-control" id="titulo" maxlength="255" required/>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">URL do Vídeo</small>
                                </label>
                                <input type="url" name="url" class="form-control" id="url" required/>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label>
                                    <small class="text-muted">Imagem (thumbnail)</small>
                                </label>
                                <input type="text" name="imagem" class="form-control" id="imagem" maxlength="200"/>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group mb-3">	
                                <label> 
                                    <small class="text-muted">Descrição</small>
                                </label>
                                <textarea  name="descricao" class="form-control tinymce" id="descricao" rows="4" required></textarea>
                            </div>
                        </div> 
                    </div>
                </form>

                <section class="section-actions video-form-actions">
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-video-editar" class="btn btn-secondary btn-float">
                          <i class="fa fa fa-pencil"></i>
                          <span class="btn-label">Editar</span>
                        </button>
                    </div>
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-video-salvar" class="btn btn-success btn-float">
                          <i class="fa fa fa-floppy-o"></i>
                          <span class="btn-label">Salvar</span>
                        </button>
                    </div>
                </section>
            </div>

            <div class="tab-pane fade" id="tab-video-arquivos">
                <div class="row">
                    <div class="col-md-12">
                        <div class="page-info-bar">
                            <small><i class="fa fa-file-text-o"></i></small>
                            <small>Arquivos</small>
                        </div>
                    </div>
                </div>               
                <form id="search-arquivos">
                    <input type="hidden" name="id_tabela_pai"  id="id-tabela-pai-form-search-arquivos" value="">
                    <div class="row" id="row-1">
                        <div class="col-md-5">
                            <div class="input-group mb-3">
                                <input type="text" name="c1"  id="c1" class="form-control" placeholder="Nome">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="input-group mb-3">
                                <input type="date" name="c2"  id="c2" class="form-control" >
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="input-group mb-3">
                                <input type="date" name="c3"  id="c3" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-1">
                            <div class="input-group mb-3">
                                <button type="button" class="btn btn-secondary" id="pesquisar-arquivos" >
                                    <i class="fa fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>      
                </form>
                <section class="section-actions">
                    <div class="section-actions-btn-parent">
                        <button class="btn btn-success btn-float section-actions-btn">
                          <i class="fa fa-search"></i>
                          <span class="btn-label">Pesquisar</span>
                        </button>
                    </div>
                    <div class="section-actions-btn-parent">
                        <button type="button" id="btn-video-upload-arquivo" class="btn btn-info btn-float section-actions-btn">
                          <i class="fa fa fa-cloud-upload"></i>
                          <span class="btn-label">Upload</span>
                        </button>
                    </div>
                </section>
                <table class="table table-hover table-bordered table-striped">
                    <thead id='thead-arquivos'>
                        <tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id='tbody-arquivos'>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section> 

<script>
    (() => {
    const videoForm = {
        formId: 'form-video',
        tabId: 'tab-form-video',
        setMode: (mode) => {
            const $editButtonParent = $('#btn-video-editar').closest('.section-actions-btn-parent');
            const $saveLabel = $('#btn-video-salvar .btn-label');
            const $saveIcon = $('#btn-video-salvar i');

            if (mode === 'create') {
                $editButtonParent.hide();
                $saveLabel.text('Cadastrar');
                $saveIcon.attr('class', 'fa fa-plus-circle');
                $(`#${videoForm.formId} :input`).prop('disabled', false);
                return;
            }

            if (mode === 'edit') {
                $editButtonParent.show();
                $saveLabel.text('Salvar');
                $saveIcon.attr('class', 'fa fa-floppy-o');
                $(`#${videoForm.formId} :input`).prop('disabled', false);
                return;
            }

            $editButtonParent.show();
            $saveLabel.text('Salvar');
            $saveIcon.attr('class', 'fa fa-floppy-o');
            $(`#${videoForm.formId} :input`).prop('disabled', true);
        },
        edit: () => {
            videoForm.setMode('edit');
        },
        cancel: () => {
            const uuid = ($(`#${videoForm.formId} [name="uuid"]`).val() || '').toString().trim();
            if (uuid) {
                videoForm.setMode('view');
                return;
            }
            videoForm.setMode('create');
        },
        populateForm: ({ url, uuid = null }) => {
            if(!uuid){
                videoForm.setMode('create');
                return;
            }
            $.ajax({
                url: `${url}/${uuid}`,
                type: 'GET',
                dataType: "json",
                beforeSend: function () {
                    admin.loading(true);
                    videoForm.setMode('view');
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    admin.loading(false);
                    toastr["error"](jqXHR.responseText);
                    videoForm.setMode('create');
                },
                success: function (response) {
                    admin.loading(false);
                    var data = response?.data || {};
                    var $form = $('#' + videoForm.formId);

                    $.each(data, function (field, value) {
                        
                        var $field = $form.find('[name="' + field + '"]');
                        
                        if (!$field.length) {
                            $field = $form.find('#' + field);
                        }

                        if (!$field.length) {
                            return;
                        }

                        var fieldType = ($field.attr('type') || '').toLowerCase();
                        var tagName = ($field.get(0)?.tagName || '').toLowerCase();

                        if (fieldType === 'text') {
                            $field.val(value ?? '');
                        }

                        if (fieldType === 'url') {
                            $field.val(value ?? '');
                        }

                        if (fieldType === 'date') {
                            $field.val(value ?? '');
                        }

                        if (fieldType === 'hidden') {
                            $field.val(value ?? '');
                        }

                        if (fieldType === 'checkbox') {
                            $field.prop('checked', !!value);
                            return;
                        }

                        if (fieldType === 'radio') {
                            $form.find('input[type="radio"][name="' + field + '"]').each(function () {
                                $(this).prop('checked', $(this).val() == value);
                            });
                            return;
                        }

                        if (tagName === 'img') {
                            if (value != '') {
                                $(container + prefix_field + field).attr('src', value + '?' + new Date().getTime());
                            }
                            return;
                        }

                        if (tagName === 'textarea') {
                            $field.val(value ?? '');

                            if (typeof tinymce !== 'undefined') {
                                var editor = tinymce.get(field);
                                if (editor) {
                                    editor.setContent(value || '');
                                }
                            }
                        }

                        if (tagName === 'select') {
                            $field.val(value ?? '');
                        }

                        if (fieldType === '' && tagName !== 'textarea' && tagName !== 'select') {
                            $field.val(value ?? '');
                        }
                    });

                    videoForm.setMode('view');
                }
            });
        },
        save: ({ formId }) => {
            if($('#'+formId+' input').length === $('#'+formId+' input:disabled').length){
                return;
            }
            if(!admin.validateForm(formId)){
                toastr["error"]("Preencha os campos obrigatórios.");
                return;
            }

            const $form = $('#' + formId);
            const uuid = ($form.find('[name="uuid"]').val() || '').toString().trim();
            const url = uuid ? `${admin.baseUrl}/video/${uuid}` : `${admin.baseUrl}/video`;
            const method = uuid ? 'PATCH' : 'POST';

            $.ajax({
                url: url,
                type: method,
                dataType: 'json',
                contentType: 'application/json',
                data: JSON.stringify($form.serializeArray().reduce(function(obj, item) {
                    if (item.name === 'id') {
                        return obj;
                    }

                    if (item.name === 'uuid' && !item.value) {
                        return obj;
                    }

                    obj[item.name] = item.value;
                    return obj;
                }, {})),
                beforeSend: function () {
                    admin.loading(true);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    admin.loading(false);
                    toastr["error"](jqXHR.responseText);
                },
                success: function (responseData) {
                    admin.loading(false);
                    var payload = responseData?.data || responseData;

                    if(payload?.uuid && !uuid){
                        $form.find('[name="uuid"]').val(payload.uuid);
                    }

                    toastr["success"]("Operação realizada com sucesso.");
                    videoForm.cancel('form-video');
                }
            });
        }
    };

    window.videoForm = videoForm;

    document.getElementById('btn-video-editar')?.addEventListener('click', () => {
        videoForm.edit('form-video');
    });

    document.getElementById('btn-video-salvar')?.addEventListener('click', () => {
        videoForm.save({ formId: videoForm.formId });
    });

    document.getElementById('btn-video-upload-arquivo')?.addEventListener('click', () => {
        const uuid = ($(`#${videoForm.formId} [name="uuid"]`).val() || '').toString().trim();
        admin.showModal({
            modalId: 'defaultModal',
            title: 'Selecionar Arquivo(s)',
            url: admin.baseUrl + endpoints.arquivo.form,
            data: {
                idTabelaPai: uuid,
                tabelaPai: 'publicacao',
            }
        });
    });

    videoForm.populateForm({ 
        url: admin.baseUrl+'/video', 
        uuid: '{{uuid}}' 
    });
    })();
</script>