<section class="section-actions">
    <div class="section-actions-btn-parent">
        <button
            class="btn btn-success btn-float section-actions-btn"
            onclick="admin.addTab({tabId:'form-video', title: 'Novo Vídeo', url: '/admin/video/form'})"
        >
            <i class="fa fa-plus"></i>
            <span class="btn-label">Novo</span>
        </button>
    </div>
    <div class="section-actions-btn-parent">
        <button class="btn btn-warning btn-float section-actions-btn" id="btn-toggle-barra">
            <i class="fa fa-search"></i>
            <span class="btn-label">Pesquisar</span>
        </button>
    </div>
</section>

<section class="section-search-bar hide" id="section-search-bar">
    <div class="row search-bar" id="search-bar">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-success-light"><span class="text-muted">Pesquisa por...</span></div>
                <div class="card-body">
                    <form id="formSearch">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="input-group mb-3">
                                    <input type="text" name="id" id="id" class="form-control" placeholder="ID">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="input-group mb-3">
                                    <input type="text" name="titulo" id="titulo" class="form-control" placeholder="Título">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="input-group mb-3">
                                    <input type="date" name="data" id="data" class="form-control">
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer p-2 border-top-0">
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-pesquisar">
                        <i class="fa fa-search"></i> Pesquisar
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="page-info-bar shadows-default">
        <small><i class="fa fa-video-camera"></i></small>
        <small>Vídeos</small>
    </div>
</section>

<section>
    <div class="list-table-container">
        <table class="table table-sm table-striped table-hover width-100">
            <thead id="thead"></thead>
            <tbody id="tbody"></tbody>
        </table>
        <div class="text-center">
            <span class="pt-5" id="messages"></span>
        </div>
    </div>
    <div class="pagination-bar-default">
        <div>
            <small class="gray-default" id="total"></small>
        </div>
        <div>
            <i class="fa fa-chevron-left gray-default cursor-pointer" id="anterior"></i>
            &emsp;
            <span class="gray-default" id="numeracao"></span>
            &emsp;
            <i class="fa fa-chevron-right gray-default cursor-pointer" id="proximo"></i>
        </div>
    </div>
</section>

<script>
    document.getElementById('btn-toggle-barra').addEventListener('click', () => {
        const barra = document.getElementById('section-search-bar');
        barra.classList.toggle('visible');
    });
    document.getElementById('btn-pesquisar').addEventListener('click', () => {
        const barra = document.getElementById('section-search-bar');
        barra.classList.toggle('visible');
        videoList.list({
            url: admin.baseUrl + endpoints.video.list,
            formSearchId: videoList.formSearchId,
        });
    });
</script>

<script>
    var videoList = {
        formSearchId: 'formSearch',
        list: ({ url, formSearchId }) => {
            $.ajax({
                url,
                cache: false,
                type: 'GET',
                data: $('#'+formSearchId).serialize(),
                dataType: "json",
                beforeSend: function () {
                    $("#messages").empty()
                    admin.loading(true);
                },
                error: function () {
                    admin.loading(false);
                    $("tr").remove();
                    $("#messages").empty()
                    $("#messages").html("<h6 class='text-muted text-center'>Não foi possivel executar a ação desejada, favor entrar em contato com o administrador.</h6>");
                },
                success: function (response) {
                    var data = response?.data || response;

                    if (!data[0]) {
                        admin.loading(false);
                        $("tr").remove();
                        $("#messages").empty()
                        $("#messages").html("<br/><br/><h6 class='text-muted text-center'>Consulta não obteve resultados.</h6>");
                        return
                    }
                    admin.loading(false);
                    $("tr").remove();
                    $("#messages").empty()

            
                    var tamanhoPagina = 10;
                    var pagina = 0;

                    function paginar() {
                        for (var i = pagina * tamanhoPagina; i < data.length && i < (pagina + 1) * tamanhoPagina; i++) {
                            $("#tbody")
                            .append(
                                `<tr id="linha${data[i].id}">
                                    <td class="p-3" style="width:90%; vertical-align: middle;">
                                        <div>
                                            <div>
                                                <small>
                                                    <b>Título: </b>${data[i].titulo} 
                                                    ${data[i].ativo == 'S' 
                                                        ? '&emsp;<span class="badge bg-success">Ativo</span>' 
                                                        :'&emsp;<span class="badge bg-secondary">Desativado</span>'
                                                    }
                                                </small>
                                                <br/>
                                                <small><b>Descrição: </b>${data[i].descricao}</small>
                                            </div>
                                            <div class="mt-3 d-flex">
                                                <div class="width-100">
                                                    <small><b>Data:</b> ${data[i].data }</small>
                                                    &emsp;
                                                    <small><b>Criado por:</b> ${data[i].criadoPor}</small>
                                                    &emsp;
                                                    <small><b>Código:</b> ${data[i].uuid}</small>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="width: 8%; vertical-align: middle;">
                                        <center>
                                            <button 
                                                class="btn btn-secondary btn-sm w-100 mb-2" 
                                                onclick="admin.addTab({
                                                    tabId:'form-video', 
                                                    title: 'Editar Vídeo', 
                                                    url: '/admin/video/form/uuid/${data[i].uuid}'
                                                })" 
                                            >
                                                <i class="fa fa-pencil"></i> Editar
                                            </button>
                                            ${data[i].ativo == 'S' 
                                                ? 
                                                    `<button class="btn btn-secondary btn-sm w-100 mb-2"  onclick="videoList.desativar('${data[i].uuid}')">
                                                        <i class="fa fa-download"></i> Desativar
                                                    </button>` 
                                                : 
                                                    `<button class="btn btn-secondary btn-sm w-100 mb-2"  onclick="videoList.ativar('${data[i].uuid}')">
                                                        <i class="fa fa-upload"></i> Ativar
                                                    </button>` 
                                            }
                                            <button class="btn btn-secondary btn-sm w-100 mb-2" onclick="videoList.remove('${data[i].uuid}')">
                                                <i class="fa fa-trash-o"></i>
                                                <span> Excluir</span>
                                            </button>   
                                        </center>
                                    </td>
                                </tr>`
                            );
                        }
                        $('#numeracao').text('Página ' + (pagina + 1) + ' de ' + Math.ceil(data.length / tamanhoPagina));
                        $('#total').text('1 à '+tamanhoPagina+ ' registros por página ');
                    }

                    function ajustarBotoes() {
                        $('#proximo').prop('disabled', data.length <= tamanhoPagina || pagina >= Math.ceil(data.length / tamanhoPagina) - 1);
                        $('#anterior').prop('disabled', data.length <= tamanhoPagina || pagina == 0);
                    }

                    $(function () {
                        $('#proximo').click(function () {
                            if (pagina < data.length / tamanhoPagina - 1) {
                                $("tr").remove();
                                pagina++;
                                paginar();
                                ajustarBotoes();
                            }
                        });
                        $('#anterior').click(function () {
                            if (pagina >= 1) {
                                $("tr").remove();
                                pagina--;
                                paginar();
                                ajustarBotoes();
                            }
                        });
                        paginar();
                        ajustarBotoes();
                    });
                }
            });
        },
        remove: (uuid) => {
            bootbox.confirm({
                title: 'Atenção',
                message: 'Tem certeza que deseja remover este registro?',
                buttons: {
                    confirm: {
                        label: '<i class="fa fa-check"></i> Confirmar',
                        className: 'btn-sm btn-success'
                    },
                    cancel: {
                        label: '<i class="fa fa-undo"></i> Cancelar',
                        className: 'btn-sm btn-secondary'
                    }
                },
                callback: function (result) {
                    if (!result) {
                        return;
                    }

                    $.ajax({
                        url: `${admin.baseUrl}/video/${uuid}`,
                        type: 'DELETE',
                        beforeSend: function () {
                            admin.loading(true);
                        },
                        success: function () {
                            admin.loading(false);
                            toastr["success"]("Vídeo removido com sucesso.");
                            videoList.list({
                                url: admin.baseUrl + endpoints.video.list,
                                formSearchId: videoList.formSearchId,
                            });
                        },
                        error: function () {
                            admin.loading(false);
                            toastr["error"]("Não foi possível remover o vídeo.");
                        }
                    });
                }
            });
        },
    };

    videoList.list({
        url: admin.baseUrl + endpoints.video.list,
        formSearchId: videoList.formSearchId,
    });
</script>