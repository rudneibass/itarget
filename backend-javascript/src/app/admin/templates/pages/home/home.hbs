<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Home</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">  
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="/admin/static/css/global.css" />
    <link rel="stylesheet" href="/admin/static/css/main-tabs.css" />
    <link rel="stylesheet" href="/admin/static/css/main-cards.css" />
    <link rel="stylesheet" href="/admin/static/css/section-actions.css" />

    <!-- <script type='text/javascript' src="http://code.jquery.com/jquery-latest.min.js"></script> -->
    <script type='text/javascript' src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script type='text/javascript' src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script type='text/javascript' src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script type='text/javascript' src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script type='text/javascript' src="https://cdnjs.cloudflare.com/ajax/libs/bootbox.js/6.0.0/bootbox.min.js"></script>
    <script type='text/javascript' src="https://kit.fontawesome.com/f3d2f6e538.js" crossorigin="anonymous"></script>
    <script type='text/javascript' src="https://cdnjs.cloudflare.com/ajax/libs/bootbox.js/6.0.0/bootbox.min.js"></script>
    <script type='text/javascript' src="https://cdn.tiny.cloud/1/bpw7icuj2r6ncv4ygunavoa1argh2n6mar2dbjbhl8wjewu6/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>  
    
    <script src="/admin/static/js/endpoints.js"></script>
    <script src="/admin/static/js/admin.js"></script>
    <script src="/admin/static/js/tinymce/5.0.4/tinymce.min.js"></script>
    <script src="/admin/static/js/tinymce/5.0.4/jquery.tinymce.min.js"></script>

  </head>
  <body>
    <div class="full-height" style="display: flex; overflow: hidden;">
      {{> aside }}
      <div style="flex: 1; min-width: 0; padding: 10px;">
        {{> header }}
        <main>
          <ul class="nav nav-tabs main-nav-tabs" id="tabs">
            <li class="nav-item main-nav-item">
              <a class="nav-link active main-nav-link" data-bs-toggle="tab" href="#home">
                <i class="fa-solid fa-house"></i> Home
              </a>
            </li>
          </ul>
          <div class="tab-content main-tab-content" id="tab-content">
            <div class="tab-pane main-tab-pane active pt-3 p-0" id="home">
              <div class="container-fluid p-0">
                <div class="row">
                  <div class="col-3">
                    <div
                      class="card h-100"
                      role="button"
                      style="cursor: pointer;"
                      onclick="admin.addTab({tabId:'form-organizacao', title: 'Organização', url: '/admin/organizacao/form'})"
                    >
                      <div class="card-body d-flex align-items-center gap-3">
                        <i class="fa-solid fa-building fs-3"></i>
                        <div>
                          <h6 class="card-title mb-1">Organização</h6>
                          <small class="card-text text-muted mb-0">Clique para criar sua organização.</small>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col-3">
                    <div
                      class="card h-100"
                      role="button"
                      style="cursor: pointer;"
                      onclick="admin.addTab({tabId:'meu-perfil', title: 'Meu Perfil', url: '/admin/usuario/me'})"
                    >
                      <div class="card-body d-flex align-items-center gap-3">
                        <i class="fa-solid fa-circle-user fs-3"></i>
                        <div>
                          <h6 class="card-title mb-1">Meu Perfil</h6>
                          <small class="card-text text-muted mb-0">Clique para visualizar seu perfil.</small>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </main>
      </div>
    </div>
    <script>
      (() => {
        const homePage = {
          openColaboradores: () => {
            $.ajax({
              url: admin.baseUrl + endpoints.usuario.colaboradores,
              type: 'GET',
              dataType: 'json',
              beforeSend: function () {
                admin.loading(true);
              },
              success: function (response) {
                admin.loading(false);
                const data = response?.data || [];
                if (!Array.isArray(data) || data.length === 0) {
                  admin.addTab({tabId:'form-usuario', title: 'Novo Usuário', url: '/admin/usuario-social/form'});
                  return;
                }

                admin.addTab({tabId:'lista_usuarios', title: 'Colaboradores', url: '/admin/usuario-social/list'});
              },
              error: function () {
                admin.loading(false);
                toastr['error']('Não foi possível consultar colaboradores.');
              },
            });
          },
        };

        window.homePage = homePage;
      })();
    </script>
  </body>
</html>
