    <script>
      (() => {
        const showError = (fieldName, message) => {
          $(`#${fieldName}-message`).text(message || 'Não foi possível concluir a operação.');
        };

        const redirectToAdmin = () => {
          window.location.href = '/landing/modulos';
        };

        $('#form-login').on('submit', async (event) => {
          event.preventDefault();
          $('#login-message').empty();

          try {
            await $.ajax({
              url: '/admin/auth/login',
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({
                email: $('#login-email').val(),
                senha: $('#login-senha').val(),
              }),
            });
            redirectToAdmin();
          } catch (error) {
            showError('login', error?.responseJSON?.message || error?.responseText || 'Credenciais inválidas.');
          }
        });

        $('#form-register').on('submit', async (event) => {
          event.preventDefault();
          $('#register-message').empty();

          try {
            await $.ajax({
              url: '/admin/auth/register',
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify({
                nome: $('#register-nome').val(),
                email: $('#register-email').val(),
                senha: $('#register-senha').val(),
              }),
            });
            redirectToAdmin();
          } catch (error) {
            showError('register', error?.responseJSON?.message || error?.responseText || 'Não foi possível cadastrar.');
          }
        });
      })();
    </script>
