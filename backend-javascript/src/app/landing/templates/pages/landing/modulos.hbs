<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Escolha de Módulo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800&display=swap" rel="stylesheet" />
    <script src="https://kit.fontawesome.com/f3d2f6e538.js" crossorigin="anonymous"></script>
    <style>
      :root {
        --bg: #09111f;
        --bg-soft: #0f1a2d;
        --panel: rgba(14, 24, 42, 0.86);
        --panel-strong: #121d31;
        --border: rgba(124, 151, 214, 0.2);
        --text: #eef4ff;
        --muted: #91a3c7;
        --marketing-1: #3b82f6;
        --marketing-2: #06b6d4;
        --disabled-1: rgba(24, 36, 61, 0.98);
        --disabled-2: rgba(17, 27, 46, 0.98);
        --shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: 'Nunito', 'Trebuchet MS', 'Segoe UI', sans-serif;
        background:
          radial-gradient(circle at top left, rgba(59, 130, 246, 0.18) 0%, transparent 26%),
          radial-gradient(circle at 85% 15%, rgba(8, 145, 178, 0.16) 0%, transparent 22%),
          linear-gradient(180deg, #08101c 0%, #0b1423 48%, #0a1120 100%);
        color: var(--text);
        padding: 24px;
      }

      .module-shell {
        width: min(1120px, 100%);
        margin: 0 auto;
        border: 1px solid var(--border);
        border-radius: 5px;
        background: linear-gradient(180deg, rgba(14, 24, 42, 0.92) 0%, rgba(10, 17, 30, 0.96) 100%);
        box-shadow: var(--shadow);
        overflow: hidden;
        backdrop-filter: blur(16px);
      }

      .module-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 24px;
        border-bottom: 1px solid rgba(125, 150, 214, 0.14);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
      }

      .module-brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .module-brand-badge {
        width: 42px;
        height: 42px;
        border-radius: 5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(6, 182, 212, 0.22) 100%);
        border: 1px solid rgba(96, 165, 250, 0.26);
        color: #9fdcff;
        font-size: 1rem;
      }

      .module-brand-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 800;
      }

      .module-brand-subtitle {
        margin: 2px 0 0;
        color: var(--muted);
        font-size: 0.84rem;
      }

      .module-topbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .module-topbar-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 14px;
        border-radius: 5px;
        border: 1px solid rgba(140, 163, 214, 0.18);
        color: #d9e5ff;
        text-decoration: none;
        font-weight: 800;
        background: rgba(255, 255, 255, 0.03);
      }

      .module-topbar-link:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(140, 163, 214, 0.28);
      }

      .module-header h1 {
        margin: 0;
        font-size: clamp(1.7rem, 3vw, 2.35rem);
        line-height: 1.1;
      }

      .module-header p {
        margin: 12px 0 0;
        color: var(--muted);
        font-size: 1rem;
        max-width: 620px;
      }

      .module-header {
        padding: 32px 28px 14px;
      }

      .module-status-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 18px;
      }

      .module-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 36px;
        padding: 0 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(136, 160, 214, 0.16);
        color: #d8e4ff;
        font-size: 0.86rem;
        font-weight: 700;
      }

      .module-grid {
        padding: 16px 28px 28px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      .module-card {
        border-radius: 5px;
        border: 1px solid rgba(141, 164, 214, 0.16);
        background: linear-gradient(180deg, var(--disabled-1) 0%, var(--disabled-2) 100%);
        min-height: 190px;
        text-decoration: none;
        color: inherit;
        padding: 18px;
        display: grid;
        align-content: space-between;
        gap: 18px;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        position: relative;
        overflow: hidden;
      }

      .module-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0) 100%);
        pointer-events: none;
      }

      .module-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
      }

      .module-icon {
        width: 52px;
        height: 52px;
        border-radius: 5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #dfe9ff;
        font-size: 1.2rem;
      }

      .module-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 28px;
        padding: 0 10px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        background: rgba(255, 255, 255, 0.07);
        color: #d8e6ff;
      }

      .module-card h2 {
        margin: 0;
        font-size: 1.16rem;
        position: relative;
        z-index: 1;
      }

      .module-card p {
        margin: 10px 0 0;
        color: #9eb0d2;
        font-size: 0.92rem;
        line-height: 1.5;
        position: relative;
        z-index: 1;
      }

      .module-card span {
        color: #aec0e3;
        font-size: 0.86rem;
        font-weight: 700;
        position: relative;
        z-index: 1;
      }

      .module-card.active {
        border-color: rgba(77, 161, 255, 0.4);
        background: linear-gradient(145deg, rgba(18, 62, 151, 0.96) 0%, rgba(8, 112, 157, 0.96) 100%);
        color: #ffffff;
        box-shadow: 0 22px 34px rgba(17, 92, 186, 0.32);
      }

      .module-card:hover {
        transform: translateY(-3px);
        border-color: rgba(140, 163, 214, 0.28);
        box-shadow: 0 20px 30px rgba(0, 0, 0, 0.22);
      }

      .module-card.active span {
        color: rgba(255, 255, 255, 0.9);
      }

      .module-card.active p {
        color: rgba(240, 248, 255, 0.88);
      }

      .module-card.disabled {
        cursor: not-allowed;
        text-align: left;
      }

      .module-card.disabled:hover {
        transform: translateY(-1px);
      }

      .module-card.disabled .module-icon {
        color: #93a5cb;
      }

      .module-footer {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 0 28px 28px;
        color: var(--muted);
        font-size: 0.9rem;
      }

      .module-footer a {
        color: #d9e5ff;
        text-decoration: none;
        font-weight: 800;
      }

      .module-footer a:hover {
        color: #ffffff;
      }

      @media (max-width: 760px) {
        body {
          padding: 14px;
        }

        .module-topbar,
        .module-header,
        .module-grid,
        .module-footer {
          padding-left: 18px;
          padding-right: 18px;
        }

        .module-topbar {
          align-items: flex-start;
          flex-direction: column;
        }

        .module-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main class="module-shell" aria-label="Escolha de módulo">
      <div class="module-topbar">
        <div class="module-brand">
          <span class="module-brand-badge">
            <i class="fa-solid fa-grid-2"></i>
          </span>
          <div>
            <p class="module-brand-title">Control Center</p>
            <p class="module-brand-subtitle">Seleção de módulo da plataforma</p>
          </div>
        </div>

        <div class="module-topbar-actions">
          <a class="module-topbar-link" href="/landing">
            <i class="fa-solid fa-arrow-left"></i>
            Voltar
          </a>
          <a class="module-topbar-link" href="/admin/logout">
            <i class="fa-solid fa-right-from-bracket"></i>
            Sair
          </a>
        </div>
      </div>

      <header class="module-header">
        <h1>Escolha o módulo que você deseja acessar</h1>
        <p>Um único acesso, múltiplas áreas da operação. Escolha onde deseja trabalhar agora.</p>

        <div class="module-status-row">
          <span class="module-status-pill">
            <i class="fa-solid fa-bolt"></i>
            1 módulo disponível agora
          </span>
          <span class="module-status-pill">
            <i class="fa-solid fa-layer-group"></i>
            3 módulos em preparação
          </span>
        </div>
      </header>

      <section class="module-grid">
        <a class="module-card active" href="/admin/home">
          <div class="module-card-top">
            <span class="module-icon">
              <i class="fa-solid fa-bullhorn"></i>
            </span>
            <span class="module-badge">Disponível</span>
          </div>
          <div>
            <h2>Marketing</h2>
            <p>Campanhas, comunicação, conteúdos, redes e presença digital da organização.</p>
          </div>
          <span>Acessar agora</span>
        </a>

        <button type="button" class="module-card disabled" data-module-name="Comercial">
          <div class="module-card-top">
            <span class="module-icon">
              <i class="fa-solid fa-chart-line"></i>
            </span>
            <span class="module-badge">Em breve</span>
          </div>
          <div>
            <h2>Comercial</h2>
            <p>Prospecção, funil de matrícula, relacionamento e conversão de oportunidades.</p>
          </div>
          <span>Em breve</span>
        </button>

        <button type="button" class="module-card disabled" data-module-name="Administrativo/Financeiro">
          <div class="module-card-top">
            <span class="module-icon">
              <i class="fa-solid fa-wallet"></i>
            </span>
            <span class="module-badge">Em breve</span>
          </div>
          <div>
            <h2>Administrativo/Financeiro</h2>
            <p>Rotinas internas, faturamento, indicadores financeiros e governança operacional.</p>
          </div>
          <span>Em breve</span>
        </button>

        <button type="button" class="module-card disabled" data-module-name="Pedagógico">
          <div class="module-card-top">
            <span class="module-icon">
              <i class="fa-solid fa-graduation-cap"></i>
            </span>
            <span class="module-badge">Em breve</span>
          </div>
          <div>
            <h2>Pedagógico</h2>
            <p>Planejamento acadêmico, acompanhamento educacional e gestão da experiência escolar.</p>
          </div>
          <span>Em breve</span>
        </button>
      </section>

      <footer class="module-footer">
        <span>Ambiente com navegação centralizada por área.</span>
        <span>Marketing já está liberado para uso.</span>
      </footer>
    </main>

    <script>
      (() => {
        const disabledModules = document.querySelectorAll('.module-card.disabled');
        disabledModules.forEach((button) => {
          button.addEventListener('click', () => {
            const moduleName = button.getAttribute('data-module-name') || 'Módulo';
            window.alert(moduleName + ' ainda não está disponível.');
          });
        });
      })();
    </script>
  </body>
</html>
