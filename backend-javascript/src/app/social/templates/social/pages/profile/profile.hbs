<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rede Social da Organizacao - Perfil</title>
    <link rel="stylesheet" href="/social/static/css/social.css" />
  </head>
  <body>
    <div class="social-shell">
      <header class="social-header">
        <div class="social-header-inner">
          <div class="social-brand">
            {{#if organization.logoUrl}}
              <img class="org-logo" src="{{organization.logoUrl}}" alt="Logo de {{organization.nome}}" />
            {{else}}
              <span class="org-logo org-logo-default" aria-label="Logo padrão da organização">🏫</span>
            {{/if}}
            <span class="org-name">{{organization.nome}}</span>
          </div>
          <div class="social-header-right">
            <div class="user-pill">
              {{#if user.urlAvatar}}
                <img class="user-avatar" src="{{user.urlAvatar}}" alt="Avatar de {{user.nome}}" />
              {{else}}
                <span class="user-avatar user-avatar-fallback">🙂</span>
              {{/if}}
              <span class="user-name">{{user.nome}}</span>
            </div>
            <div class="coin-badge">🪙 Moedas: {{moedas}}</div>
          </div>
        </div>
      </header>
      <nav class="social-nav">
        <a href="/social/home">Home</a>
        <a class="active" href="/social/profile">Perfil</a>
        <a href="/social/activities">Atividades</a>
        <a href="/social/games">Jogos</a>
        <a href="/social/rewards">Recompensas</a>
        <a href="/social/chat">Chat</a>
      </nav>

      <section class="social-card">
        <h3>{{user.nome}}</h3>
        <p><strong>UUID:</strong> {{user.uuid}}</p>
        <p><strong>Pode postar mídia:</strong> {{user.podePostarMidia}}</p>
        <p><strong>Pode postar link:</strong> {{user.podePostarLink}}</p>
      </section>
    </div>
  </body>
</html>
