<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rede Social da Organizacao - Perfil</title>
    <link rel="stylesheet" href="/social/static/css/social.css" />
  </head>
  <body class="profile-page-transparent">
    <div class="social-shell">
      {{> socialHeader }}
      {{> socialNav activeProfile=true }}

      <main class="profile-main">
        <section class="profile-card profile-top">
          <div class="profile-avatar-wrap">
            {{#if user.urlAvatar}}
              <img class="profile-avatar" src="{{user.urlAvatar}}" alt="Avatar de {{#if user.apelido}}{{user.apelido}}{{else}}{{user.nome}}{{/if}}" />
            {{else}}
              <span class="profile-avatar profile-avatar-fallback" aria-hidden="true">🙂</span>
            {{/if}}
          </div>

          <div class="profile-main-info">
            <div class="profile-handle-row">
              <h2 class="profile-handle">{{#if user.apelido}}@{{user.apelido}}{{else}}@{{user.nome}}{{/if}}</h2>
              <span class="profile-chip">Perfil social</span>
            </div>

            <div class="profile-stats" aria-label="Estatísticas do perfil">
              <div class="profile-stat">
                <strong>{{postsCount}}</strong>
                <span>publicações</span>
              </div>
              <div class="profile-stat">
                <strong>{{moedas}}</strong>
                <span>moedas</span>
              </div>
              <div class="profile-stat">
                <strong>{{organization.nome}}</strong>
                <span>organização</span>
              </div>
            </div>

            <div class="profile-bio">
              <strong>{{user.nome}}</strong>
              <p>Participando da comunidade da {{organization.nome}}.</p>
            </div>
          </div>
        </section>

        <section class="profile-highlights" aria-label="Destaques">
          <article class="highlight-item">
            <span class="highlight-ring">
              {{#if user.urlAvatar}}
                <img src="{{user.urlAvatar}}" alt="Foto do usuário logado" />
              {{else}}
                <span class="highlight-fallback">🙂</span>
              {{/if}}
            </span>
            <span class="highlight-label">Você</span>
          </article>

          <article class="highlight-item">
            <span class="highlight-ring">
              {{#if organization.logoUrl}}
                <img src="{{organization.logoUrl}}" alt="Foto da organização {{organization.nome}}" />
              {{else}}
                <span class="highlight-fallback">🏫</span>
              {{/if}}
            </span>
            <span class="highlight-label">{{organization.nome}}</span>
          </article>
        </section>

        <section class="profile-posts-card">
          {{#if profileTimeline.length}}
            <div class="profile-post-grid">
              {{#each profileTimeline}}
                <article class="profile-post-item" data-post-uuid="{{uuid}}">
                  {{#if midiaUrl}}
                    {{#if isVideo}}
                      <video class="profile-post-media" controls preload="metadata" poster="{{midiaUrl}}">
                        <source src="{{midiaUrl}}" type="video/mp4" />
                        Seu navegador não suporta reprodução de vídeo.
                      </video>
                    {{else}}
                      <img class="profile-post-media" src="{{midiaUrl}}" alt="Mídia da postagem" />
                    {{/if}}
                  {{else if isInstagram}}
                    <div class="profile-post-instagram">
                      <span>Instagram</span>
                    </div>
                  {{else}}
                    <div class="profile-post-text{{#if isTextHighlight}} profile-post-text--highlight profile-post-text--{{textHighlightVariant}}{{/if}}">
                      <p>{{#if texto}}{{texto}}{{else}}Sem legenda{{/if}}</p>
                    </div>
                  {{/if}}
                </article>
              {{/each}}
            </div>
          {{else}}
            <p class="muted">Você ainda não publicou conteúdo.</p>
          {{/if}}
        </section>
      </main>
    </div>
  </body>
</html>
